% Slide-local downgrades for mixed CUI/classified presentations.  The overall
% title slide always retains the document banner.  This scope applies to one
% frame-producing construct, including the custom team/milestone/background
% helpers, and then restores the inclusive document marking automatically.
\ExplSyntaxOn
\bool_new:N \l_ls_slide_marking_active_bool
\bool_new:N \g_ls_slide_prior_shipout_bool
\int_new:N \g_ls_slide_marking_frame_count_int
\int_new:N \g_ls_slide_marking_shipout_count_int

\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-nested}
  {LSSlideMarking~environments~cannot~be~nested.}
  {Close~the~current~one-frame~marking~scope~before~opening~another.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-first}
  {The~first~slide~cannot~use~a~downgraded~slide~marking.}
  {Render~the~classified~document's~inclusive~banner~and~title-page~notices~on~slide~one.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-profile}
  {LSSlideMarking~requires~an~authorized~CUI-bearing~or~classified~document~profile.}
  {Use~profile=cui-general,~cui-dod,~classified-general,~or~classified-dod;~ordinary~uncontrolled/corporate/unclassified~decks~do~not~need~slide-local~downgrades.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-mode}
  {Unknown~slide-marking~mode~'#1'.}
  {Use~exactly~unclassified~or~cui.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-count}
  {LSSlideMarking~contains~#1~frames.}
  {Wrap~exactly~one~frame~or~one~frame-producing~Linear~Space~helper.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-pages}
  {LSSlideMarking~produced~#1~physical~slides.}
  {Use~one~nonbreaking~frame;~bibliography/acronym~continuations~must~retain~the~inclusive~document~banner.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-unclassified-banner}
  {The~optional~banner~argument~must~be~blank~for~unclassified~mode.}
  {Use~\string\begin{LSSlideMarking}\{unclassified\};~the~exact~UNCLASSIFIED~banner~is~automatic.}
\msg_new:nnnn {beamerthemeLinearSpace}{slide-marking-breaking}
  {LSSlideMarking~cannot~wrap~a~frame~with~allowframebreaks.}
  {A~local~downgrade~must~produce~exactly~one~physical~slide;~use~the~inclusive~document~banner~for~continuations.}

\cs_new_protected:Npn \LSInternalSlideMarkingFrameBegin
  {
    \bool_if:NT \l_ls_slide_marking_active_bool
      {
        \int_gincr:N \g_ls_slide_marking_frame_count_int
        \int_compare:nNnT {\g_ls_slide_marking_frame_count_int} > {1}
          {\msg_fatal:nne {beamerthemeLinearSpace}{slide-marking-count}
            {\int_use:N \g_ls_slide_marking_frame_count_int}}
      }
  }

\cs_new_protected:Npn \LSInternalSlideMarkingShipoutBefore
  {
    \bool_if:NT \l_ls_slide_marking_active_bool
      {
        \int_gincr:N \g_ls_slide_marking_shipout_count_int
        \int_compare:nNnT {\g_ls_slide_marking_shipout_count_int} > {1}
          {\msg_fatal:nne {beamerthemeLinearSpace}{slide-marking-pages}
            {\int_use:N \g_ls_slide_marking_shipout_count_int}}
      }
  }

\cs_new_protected:Npn \LSInternalSlideMarkingShipoutAfter
  {\bool_gset_true:N \g_ls_slide_prior_shipout_bool}

\cs_new_protected:Npn \LSInternalSlideMarkingAllowFrameBreaks
  {\bool_if:NT \l_ls_slide_marking_active_bool
    {\msg_fatal:nn {beamerthemeLinearSpace}{slide-marking-breaking}}}

\cs_new_protected:Npn \ls_slide_marking_prepare:nn #1#2
  {
    \bool_set_false:N \l_tmpa_bool
    \ls_profile_cui:T {\bool_set_true:N \l_tmpa_bool}
    \ls_profile_classified:T {\bool_set_true:N \l_tmpa_bool}
    \bool_if:NF \l_tmpa_bool
      {\msg_fatal:nn {beamerthemeLinearSpace}{slide-marking-profile}}
    \str_case:nnF {#2}
      {
        {unclassified}
          {
            \tl_if_blank:nF {#1}
              {\msg_fatal:nn {beamerthemeLinearSpace}
                {slide-marking-unclassified-banner}}
            \def\LSFrameBannerText{UNCLASSIFIED}
            \def\LSFrameBannerColor{LSUnclassifiedGreen}
          }
        {cui}
          {
            \tl_if_blank:nTF {#1}
              {\LSValidateCUIOnlyBanner{CUI}}
              {\LSValidateCUIOnlyBanner{#1}}
            \edef\LSFrameBannerText{\LSValidatedBannerText}
            \def\LSFrameBannerColor{LSPurple}
          }
      }
      {\msg_fatal:nnn {beamerthemeLinearSpace}{slide-marking-mode}{#2}}
  }

\NewDocumentEnvironment{LSSlideMarking}{O{} m +b}{%
  \begingroup
    \bool_if:NT \l_ls_slide_marking_active_bool
      {\msg_fatal:nn {beamerthemeLinearSpace}{slide-marking-nested}}
    \bool_if:NF \g_ls_slide_prior_shipout_bool
      {\msg_fatal:nn {beamerthemeLinearSpace}{slide-marking-first}}
    \ls_slide_marking_prepare:nn {#1}{#2}
    \int_gzero:N \g_ls_slide_marking_frame_count_int
    \int_gzero:N \g_ls_slide_marking_shipout_count_int
    \bool_set_true:N \l_ls_slide_marking_active_bool
    #3%
    \bool_set_false:N \l_ls_slide_marking_active_bool
    \int_compare:nNnF {\g_ls_slide_marking_frame_count_int} = {1}
      {\msg_fatal:nne {beamerthemeLinearSpace}{slide-marking-count}
        {\int_use:N \g_ls_slide_marking_frame_count_int}}
    \int_compare:nNnF {\g_ls_slide_marking_shipout_count_int} = {1}
      {\msg_fatal:nne {beamerthemeLinearSpace}{slide-marking-pages}
        {\int_use:N \g_ls_slide_marking_shipout_count_int}}
    \int_gzero:N \g_ls_slide_marking_frame_count_int
    \int_gzero:N \g_ls_slide_marking_shipout_count_int
  \endgroup
}{}
\ExplSyntaxOff

\AtBeginEnvironment{frame}{\LSInternalSlideMarkingFrameBegin}
\AddToHook{shipout/before}{\LSInternalSlideMarkingShipoutBefore}
\AddToHook{shipout/after}{\LSInternalSlideMarkingShipoutAfter}
\let\ls@originalallowframebreakskey\KV@beamerframe@allowframebreaks
\define@key{beamerframe}{allowframebreaks}[0.95]{%
  \LSInternalSlideMarkingAllowFrameBreaks
  \ls@originalallowframebreakskey{#1}%
}

% Use the same measured bar in the headline and footline so controlled banners
% have identical height and do not depend on \colorbox's default padding.
\newcommand{\ls@bannerbar}{%
  \LSConfirmAlternateBannerRendered
  \begin{tikzpicture}[baseline=0pt]
    \path[use as bounding box] (0,0) rectangle (\paperwidth,0.19in);
    \fill[\LSFrameBannerColor] (0,0) rectangle (\paperwidth,0.19in);
    \node[
      anchor=center,inner sep=0pt,align=center,text=white,
      text width=\dimexpr\paperwidth-0.20in\relax,
      font=\sffamily\bfseries\fontsize{8.5}{9.5}\selectfont
    ] at (0.5\paperwidth,0.095in) {\LSFrameBannerText};
  \end{tikzpicture}%
}

\setbeamertemplate{headline}{%
  \LSIfBlankTF{\LSFrameBannerText}{}{%
    \ls@bannerbar
  }%
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.70in,dp=0.07in,leftskip=0.30in,rightskip=0.30in]{frametitle}
    \leftskip=0.30in\relax
    \rightskip=0.30in plus 2em\relax
    \parfillskip=0pt plus 1fil\relax
    \hyphenpenalty=10000\exhyphenpenalty=10000%
    \usebeamerfont{frametitle}\insertframetitle
    \ifx\insertframesubtitle\@empty\else
      \par\vspace{0.05in}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
    \fi
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode
  \hbox to \paperwidth{\hspace{0.26in}\color{LSDeckRule}\rule{\dimexpr\paperwidth-0.52in\relax}{0.45pt}\hspace{0.26in}}
  \vspace{0.055in}
  \hbox to \paperwidth{%
    \begin{beamercolorbox}[
      wd=\dimexpr\paperwidth/3\relax,ht=0.22in,dp=0.03in,
      left,leftskip=0.28in
    ]{footline}
      \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
      \textcolor{LSDeckOffWhite}{\LSShortTitle}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[
      wd=\dimexpr\paperwidth/3\relax,ht=0.22in,dp=0.03in,center
    ]{footline}
      \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
      \textcolor{LSDeckOffWhite}{\LSDocumentID\enspace\textbullet\enspace Rev.~\LSRevision}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[
      wd=\dimexpr\paperwidth/3\relax,ht=0.22in,dp=0.03in,
      right,rightskip=0.28in
    ]{footline}
      \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
      \textcolor{LSDeckOffWhite}{\insertframenumber\,/\,\inserttotalframenumber}
    \end{beamercolorbox}%
  }
  \LSIfBlankTF{\LSFrameBannerText}{}{%
    \ls@bannerbar
  }%
}

\newcommand{\ls@titleforegroundbanner}{%
  \LSIfBlankTF{\LSFrameBannerText}{}{%
    \LSConfirmAlternateBannerRendered
    \begin{tikzpicture}[remember picture,overlay]
      \fill[\LSFrameBannerColor]
        (current page.north west) rectangle
        ([yshift=-0.19in]current page.north east);
      \node[
        anchor=center,text=white,inner sep=0pt,align=center,
        text width=\dimexpr\paperwidth-0.20in\relax,
        font=\sffamily\bfseries\fontsize{8.5}{9.5}\selectfont
      ] at ([yshift=-0.095in]current page.north) {\LSFrameBannerText};
    \end{tikzpicture}%
  }%
}

% Any marked deck needs the compact title composition even when its notice
% count is only one or two; the banner itself consumes protected canvas at both
% edges and the complete cover notice must remain above the footer.
\newcommand{\ls@ifcompacttitleTF}[2]{%
  \LSIfDenseMarkingsTF{#1}{%
    \LSIfBlankTF{\LSFrameBannerText}{#2}{#1}%
  }%
}

\setbeamertemplate{title page}{%
  \begingroup
  \renewcommand{\ls@backgroundfile}{\LSTitleBackgroundFile}%
  \ls@requirebackground{\LSTitleBackgroundFile}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=center,inner sep=0] at
      ([xshift=\LSTitleBackgroundXShift,yshift=\LSTitleBackgroundYShift]current page.center)
      {\ls@covergraphic{\LSTitleBackgroundFile}};
    \fill[LSDeckBlack,opacity=\LSTitleBackgroundOverlayOpacity]
      (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}
  \ls@syntheticdemowatermark
  \ls@titleforegroundbanner
  \ls@ifcompacttitleTF{%
    \vspace*{0.19in}
    \begin{minipage}{0.94\textwidth}
      \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
      \LSWordmarkOnDark[1.05in]\par
