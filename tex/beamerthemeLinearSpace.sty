\newcommand{\ls@roundedimage}[3]{%
  \begingroup
  \edef\ls@roundedimagefile{\ls@resolvebackground{#1}}%
  \ls@requirebackground{\ls@roundedimagefile}%
  \begin{tikzpicture}
    \path[use as bounding box] (0,0) rectangle (#2,#3);
    \clip[rounded corners=0.10in] (0,0) rectangle (#2,#3);
    \node[anchor=center,inner sep=0] at ($(0,0)!0.5!(#2,#3)$)
      {\ls@covergraphicbox{\ls@roundedimagefile}{#2}{#3}};
  \end{tikzpicture}%
  \endgroup
}

\newcommand{\ls@teamplaceholder}[2]{%
  \begin{tikzpicture}
    \path[use as bounding box] (0,0) rectangle (#1,#2);
    \node[
      anchor=center,fill=LSDeckBlack!72,text=LSDeckLime,
      rounded corners=0.10in,minimum width=#1,minimum height=#2,
      inner sep=0pt,font=\bfseries\fontsize{25}{25}\selectfont
    ] at ($(0,0)!0.5!(#1,#2)$) {\ls@teaminitials};
  \end{tikzpicture}%
}

\newcommand{\ls@teamcard}[5]{%
  \begin{tikzpicture}[baseline=0pt]
    \node[
      anchor=north west,fill=LSDeckCharcoal!94,draw=LSDeckRule!58,
      line width=0.55pt,rounded corners=0.13in,inner sep=0.13in,
      text width=\dimexpr\ls@teamcardwidth-0.26in\relax,
      minimum height=3.02in
    ] (card) at (0,0) {%
      \centering
      \def\ls@teaminitials{#1}%
      \ifstrempty{#2}
        {\ls@teamplaceholder{\linewidth}{\ls@teamphotoheight}}
        {\ls@roundedimage{#2}{\linewidth}{\ls@teamphotoheight}}%
      \par\vspace{0.10in}
      {\fontsize{\ls@teamnamesize}{\ls@teamnameleading}\selectfont
       \bfseries\color{LSDeckLime}#3\par}
      \vspace{0.025in}
      {\fontsize{13}{16}\selectfont\bfseries\color{LSDeckWhite}#4\par}
      \vspace{0.055in}
      {\fontsize{12.5}{15.5}\selectfont\color{LSDeckOffWhite}\RaggedRight #5\par}
    };
    \path[use as bounding box] (0,-3.08in) rectangle (\ls@teamcardwidth,0);
  \end{tikzpicture}%
}

\newcommand{\ls@teammediapanel}{%
  \ls@roundedimage{\ls@teammedia}{\ls@teammediawidth}{3.02in}%
}

