\ExplSyntaxOn
\msg_new:nnnn {beamerthemeLinearSpace}{title-overlay-range}
  {Title~background~overlay~'#1'~is~outside~the~supported~range.}
  {Use~a~decimal~opacity~from~0~(no~darkening)~through~1~(fully~black).}
\NewDocumentCommand{\LSTitleBackgroundOverlay}{m}
  {
    \fp_compare:nNnTF {#1} < {0}
      {\msg_fatal:nnn {beamerthemeLinearSpace}{title-overlay-range}{#1}}
      {
        \fp_compare:nNnTF {#1} > {1}
          {\msg_fatal:nnn {beamerthemeLinearSpace}{title-overlay-range}{#1}}
          {\cs_set:Npx \LSTitleBackgroundOverlayOpacity {\fp_eval:n {#1}}}
      }
  }
\ExplSyntaxOff
\NewDocumentCommand{\LSTitleBackgroundCredit}{m}{%
  \renewcommand{\LSTitleBackgroundCreditText}{#1}%
}
\NewDocumentCommand{\LSEnableSyntheticDemoWatermark}{}{\ls@syntheticdemotrue}

\newsavebox{\ls@scaledimagebox}
\newcommand{\ls@covergraphic}[1]{%
  \sbox{\ls@scaledimagebox}{\includegraphics[width=\paperwidth]{#1}}%
  \ifdim\ht\ls@scaledimagebox<\paperheight
    \includegraphics[height=\paperheight]{#1}%
  \else
    \usebox{\ls@scaledimagebox}%
  \fi
}

% Cover-crop an image into an arbitrary box while preserving aspect ratio.
% The surrounding TikZ clip controls the visible crop; the image itself is
% never stretched.
\newsavebox{\ls@coverbox}
\newcommand{\ls@covergraphicbox}[3]{%
  \sbox{\ls@coverbox}{\includegraphics[width=#2]{#1}}%
  \ifdim\ht\ls@coverbox<#3
    \includegraphics[height=#3]{#1}%
  \else
    \usebox{\ls@coverbox}%
  \fi
}

\newcommand{\ls@syntheticdemowatermark}{%
  \ifls@syntheticdemo
    \begin{tikzpicture}[remember picture,overlay]
      \node[
        rotate=16,text=LSDeckWhite,opacity=0.16,
        font=\bfseries\fontsize{24}{28}\selectfont,
        inner sep=0pt
      ] at (current page.center)
        {SYNTHETIC DEMONSTRATION --- NOT CLASSIFIED};
    \end{tikzpicture}%
  \fi
}

\newcommand{\ls@paintbackground}{%
  % Draw a real paper-sized canvas.  A remembered overlay alone can leave the
  % body transparent when a large custom TikZ layout changes the frame's box
  % origin; the fixed canvas keeps every frame dark in every PDF renderer.
  \begin{tikzpicture}[baseline=0pt]
    \path[use as bounding box] (0,0) rectangle (\paperwidth,\paperheight);
    \fill[LSDeckBlack] (0,0) rectangle (\paperwidth,\paperheight);
    \ifdefempty{\ls@backgroundfile}
      {}
      {%
        \ls@requirebackground{\ls@backgroundfile}%
        \node[
          anchor=center,inner sep=0,
          xshift=\ls@backgroundxshift,yshift=\ls@backgroundyshift
        ] at (0.5\paperwidth,0.5\paperheight)
          {\ls@covergraphic{\ls@backgroundfile}};
        \fill[LSDeckBlack,opacity=\ls@backgroundopacity]
          (0,0) rectangle (\paperwidth,\paperheight);
      }%
  \end{tikzpicture}%
  \ls@syntheticdemowatermark
}

\setbeamertemplate{background canvas}{\ls@paintbackground}

\NewDocumentEnvironment{LSImageFrame}{O{0.42} m +b}{%
  \begingroup
  \edef\ls@backgroundfile{\ls@resolvebackground{#2}}%
  \ls@requirebackground{\ls@backgroundfile}%
  \renewcommand{\ls@backgroundopacity}{#1}%
  \renewcommand{\ls@backgroundxshift}{0in}%
  \renewcommand{\ls@backgroundyshift}{0in}%
  \begin{frame}#3%
  \end{frame}
  \endgroup
}{}

% Key-value successor to LSImageFrame.  Use a registered name or direct path;
% focal shifts move the cover-cropped image without changing its aspect ratio.
\pgfkeys{
  /ls/background frame/.is family,
  /ls/background frame,
  opacity/.store in=\ls@framebackgroundopacity,
  focal-x/.store in=\ls@framebackgroundxshift,
  focal-y/.store in=\ls@framebackgroundyshift,
}
\NewDocumentEnvironment{LSBackgroundFrame}{O{} m +b}{%
  \begingroup
  \def\ls@framebackgroundopacity{0.42}%
  \def\ls@framebackgroundxshift{0in}%
  \def\ls@framebackgroundyshift{0in}%
  \pgfkeys{/ls/background frame,#1}%
  \edef\ls@backgroundfile{\ls@resolvebackground{#2}}%
  \ls@requirebackground{\ls@backgroundfile}%
  \edef\ls@backgroundopacity{\ls@framebackgroundopacity}%
  \edef\ls@backgroundxshift{\ls@framebackgroundxshift}%
  \edef\ls@backgroundyshift{\ls@framebackgroundyshift}%
  \begin{frame}#3%
  \end{frame}
  \endgroup
}{}

