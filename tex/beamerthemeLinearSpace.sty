% Acronym and bibliography frames are deliberately separate: readers can scan
% terminology quickly, while source lists can break across as many slides as
% needed.  The references helper fails clearly unless biblatex was loaded.
\renewcommand{\LSAcronymShortStyle}[1]{\textbf{\color{LSDeckLime}#1}}
\renewcommand{\LSAcronymLongStyle}[1]{\color{LSDeckOffWhite}#1}
\NewDocumentCommand{\LSAcronymFrame}{O{Acronyms and abbreviations}}{%
  \begingroup
  \setbeamertemplate{frametitle continuation}{%
    \ifnum\insertcontinuationcount>1\relax\space(continued)\fi
  }%
  \begin{frame}[t,allowframebreaks=0.88]{#1}
    \vspace{0.06in}
    {\fontsize{16}{20}\selectfont\LSPrintAcronyms}
  \end{frame}
  \endgroup
}

\NewDocumentCommand{\LSReferencesFrame}{O{References}}{%
  \@ifpackageloaded{biblatex}{%
    \begingroup
    \setbeamertemplate{frametitle continuation}{%
      \ifnum\insertcontinuationcount>1\relax\space(continued)\fi
    }%
    \setbeamerfont{bibliography item}{size=\fontsize{13.5}{17}}
    \setbeamerfont{bibliography entry author}{size=\fontsize{13.5}{17},series=\bfseries}
    \setbeamerfont{bibliography entry title}{size=\fontsize{13.5}{17}}
    \setbeamerfont{bibliography entry location}{size=\fontsize{12.5}{16}}
    \setbeamerfont{bibliography entry note}{size=\fontsize{12.5}{16}}
    \begin{frame}[t,allowframebreaks=0.88]{#1}
      \printbibliography[heading=none]
    \end{frame}
    \endgroup
  }{%
    \PackageError{beamerthemeLinearSpace}
      {\string\LSReferencesFrame\space requires biblatex}
      {Load biblatex and add one or more bibliography resources in the preamble.}%
  }%
}

% Optional expanded duplicate for audiences that benefit from a dedicated
% handling slide. The title frame already carries every required cover notice.
\NewDocumentCommand{\LSMarkingDisclosureFrame}{}{%
  \begingroup
    \setbeamertemplate{frametitle continuation}{%
      \ifnum\insertcontinuationcount>1\relax\space(continued)\fi
    }%
    \renewcommand{\small}{\fontsize{13}{16}\selectfont}%
    \LSIfDoDExportTechnicalInformationTF{%
      \begin{frame}[t,allowframebreaks=0.88]{DoDD 5230.25 notice}
        \vspace{0.06in}
        \LSDoDReleaseNotice
      \end{frame}%
    }{%
      \begin{frame}[t,allowframebreaks=0.88]{Handling, authority, and distribution}
        \vspace{0.06in}
        \LSMarkingNotices
      \end{frame}%
    }%
  \endgroup
}

