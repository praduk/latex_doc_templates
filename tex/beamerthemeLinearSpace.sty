\NewDocumentCommand{\LSMilestone}{O{} m m +m m}
  {
    \bool_if:NTF \l_ls_milestone_collecting_bool
      {\seq_put_right:Nn \l_ls_milestone_seq
        {\ls_milestone_node:nnnnn {#1}{#2}{#3}{#4}{#5}}}
      {\msg_fatal:nn {beamerthemeLinearSpace}{milestone-outside}}
  }

\cs_new_protected:Npn \ls_milestone_node:nnnnn #1#2#3#4#5
  {
    \group_begin:
      \def\ls@milestonestatus{upcoming}
      \def\ls@milestoneaccent{LSDeckLime}
      \pgfkeys{/ls/milestone,status=upcoming,accent=LSDeckLime,#1}
      \bool_if:NTF \l_ls_milestone_compact_bool
        {
          \int_compare:nNnTF {\l_ls_milestone_index_int} < {6}
            {
              \int_set:Nn \l_ls_milestone_row_count_int {5}
              \int_set_eq:NN \l_ls_milestone_row_index_int
                \l_ls_milestone_index_int
              \dim_set:Nn \l_ls_milestone_row_y_dim {0.75in}
            }
            {
              \int_set:Nn \l_ls_milestone_row_count_int
                {\l_ls_milestone_count_int - 5}
              \int_set:Nn \l_ls_milestone_row_index_int
                {\l_ls_milestone_index_int - 5}
              \dim_set:Nn \l_ls_milestone_row_y_dim {-1.28in}
            }
        }
        {
          \int_set_eq:NN \l_ls_milestone_row_count_int
            \l_ls_milestone_count_int
          \int_set_eq:NN \l_ls_milestone_row_index_int
            \l_ls_milestone_index_int
          \dim_zero:N \l_ls_milestone_row_y_dim
        }
      \dim_set:Nn \l_ls_milestone_position_dim
        {
          \linewidth / 2
          + \l_ls_milestone_step_dim
            * (2 * \l_ls_milestone_row_index_int
               - \l_ls_milestone_row_count_int - 1) / 2
        }
      \def\ls@milestonenodefill{LSDeckCharcoal}
      \def\ls@milestonenodedraw{LSDeckRule}
      \def\ls@milestonenodetext{\ls@milestoneaccent}
      \def\ls@milestonetitlecolor{LSDeckOffWhite}
      \def\ls@milestonedatefill{LSDeckCharcoal}
      \def\ls@milestonedatedraw{LSDeckRule}
      \def\ls@milestonedatetext{\ls@milestoneaccent}
      \def\ls@milestonedateprefix{}
      \def\ls@milestonenodeline{0.7pt}
      \ifdefstring{\ls@milestonestatus}{completed}{
        \def\ls@milestonenodefill{\ls@milestoneaccent}
        \def\ls@milestonenodedraw{\ls@milestoneaccent}
        \def\ls@milestonenodetext{LSDeckBlack}
        \def\ls@milestonetitlecolor{\ls@milestoneaccent}
        \def\ls@milestonedatefill{\ls@milestoneaccent}
        \def\ls@milestonedatedraw{\ls@milestoneaccent}
        \def\ls@milestonedatetext{LSDeckBlack}
        \def\ls@milestonedateprefix{COMPLETE\enspace\textbullet\enspace}
      }{}
      \ifdefstring{\ls@milestonestatus}{in-progress}{
        \def\ls@milestonenodedraw{\ls@milestoneaccent}
        \def\ls@milestonenodetext{\ls@milestoneaccent}
        \def\ls@milestonetitlecolor{\ls@milestoneaccent}
        \def\ls@milestonedatefill{LSDeckBlack}
        \def\ls@milestonedatedraw{\ls@milestoneaccent}
        \def\ls@milestonedatetext{\ls@milestoneaccent}
        \def\ls@milestonedateprefix{IN~PROGRESS\enspace\textbullet\enspace}
        \def\ls@milestonenodeline{2.0pt}
      }{}
      \begin{scope}[shift={(\dim_use:N \l_ls_milestone_position_dim,
                            \dim_use:N \l_ls_milestone_row_y_dim)}]
        \ifdefstring{\ls@milestonestatus}{completed}{
          \node[
            circle,fill=\ls@milestonenodefill,text=\ls@milestonenodetext,
            minimum~size=\ls@milestonemarkersize,inner~sep=0pt,
            font=\bfseries\fontsize{\ls@milestonemarkersizefont}
              {\ls@milestonemarkersizefont}\selectfont
          ] at (0,0) {#2};
        }{
          \node[
            fill=\ls@milestonenodefill,draw=\ls@milestonenodedraw,
            text=\ls@milestonenodetext,line~width=\ls@milestonenodeline,
            rounded~corners=\ls@milestonecornerradius,
            minimum~width=\ls@milestonemarkersize,
            minimum~height=\ls@milestonemarkersize,inner~sep=0pt,
            font=\bfseries\fontsize{\ls@milestonemarkersizefont}
              {\ls@milestonemarkersizefont}\selectfont
          ] at (0,0) {#2};
          \ifdefstring{\ls@milestonestatus}{in-progress}{
            \fill[\ls@milestoneaccent]
              (\ls@milestoneactivityoffset,\ls@milestoneactivityoffset)
              circle[radius=\ls@milestoneactivityradius];
          }{}
        }
      \end{scope}
      \node[
        anchor=north,inner~sep=0pt,align=center,
        text~width=\dim_eval:n {\l_ls_milestone_card_width_dim - 0.04in}
      ] at (\dim_use:N \l_ls_milestone_position_dim,
            \dim_eval:n
              {\l_ls_milestone_row_y_dim - \ls@milestonecontentoffset})
      {
        \begin{minipage}{\dim_eval:n {\l_ls_milestone_card_width_dim - 0.04in}}
          \centering
          \begin{minipage}[t][\ls@milestonetitleslot][t]
            {\dim_eval:n {\l_ls_milestone_card_width_dim - 0.04in}}
            \centering
            {\fontsize{\ls@milestonetitlesize}{\ls@milestonetitleleading}
             \selectfont\bfseries
             \color{\ls@milestonetitlecolor}#3\par}
          \end{minipage}\par
          \vspace{\ls@milestonetitlegap}
          \begin{minipage}[t][\ls@milestonebodyslot][t]
            {\dim_eval:n {\l_ls_milestone_card_width_dim - 0.04in}}
            \centering
            {\fontsize{\ls@milestonebodysize}{\ls@milestonebodyleading}
             \selectfont\color{LSDeckOffWhite}#4\par}
          \end{minipage}\par
          \vspace{\ls@milestonedategap}
          \begingroup
            \setlength{\fboxsep}{\ls@milestonedatepadding}
            \setlength{\fboxrule}{0.8pt}
            \fcolorbox{\ls@milestonedatedraw}{\ls@milestonedatefill}{%
              \makebox[\dim_eval:n
                {\l_ls_milestone_card_width_dim - \ls@milestonedateinset}][c]{%
                \strut\bfseries
                \fontsize{\ls@milestonedatesize}{\ls@milestonedateleading}
                \selectfont
                \color{\ls@milestonedatetext}\ls@milestonedateprefix#5}}
          \endgroup
        \end{minipage}
      };
    \group_end:
  }

\cs_new_protected:Npn \ls_milestone_connector:nn #1#2
  {
    \int_compare:nNnT {#1} > {1}
      {
        \dim_set:Nn \l_ls_milestone_connector_left_dim
          {\linewidth / 2 - \l_ls_milestone_step_dim * (#1 - 1) / 2}
        \dim_set:Nn \l_ls_milestone_connector_right_dim
          {\linewidth / 2 + \l_ls_milestone_step_dim * (#1 - 1) / 2}
        \draw[LSDeckLime!82,line~width=1.15pt,densely~dotted]
          (\dim_use:N \l_ls_milestone_connector_left_dim,#2) --
          (\dim_use:N \l_ls_milestone_connector_right_dim,#2);
      }
  }

% Continue the sequence from gate 5 to gate 6 without crossing either row's
% content.  The rails live in the frame's protected side gutters and the long
% horizontal segment uses a dedicated channel between the two complete rows.
% Gate 6's x coordinate is derived from the centered active second row.
\cs_new_protected:Npn \ls_milestone_wrap_connector:
  {
    \dim_set:Nn \l_ls_milestone_wrap_start_dim
      {\linewidth / 2 + \l_ls_milestone_step_dim * 2
        + \ls@milestonemarkersize / 2}
    \dim_set:Nn \l_ls_milestone_wrap_end_dim
      {\linewidth / 2
        - \l_ls_milestone_step_dim
          * (\l_ls_milestone_count_int - 6) / 2
        - \ls@milestonemarkersize / 2}
    \dim_set:Nn \l_ls_milestone_wrap_left_rail_dim {-0.10in}
    \dim_set:Nn \l_ls_milestone_wrap_right_rail_dim
      {\linewidth + 0.10in}
    \draw[
      LSDeckLime!82,line~width=1.15pt,densely~dotted,
      line~cap=round,line~join=round,rounded~corners=0.10in
    ]
      (\dim_use:N \l_ls_milestone_wrap_start_dim,0.75in) --
      (\dim_use:N \l_ls_milestone_wrap_right_rail_dim,0.75in) --
      (\dim_use:N \l_ls_milestone_wrap_right_rail_dim,-0.93in) --
      (\dim_use:N \l_ls_milestone_wrap_left_rail_dim,-0.93in) --
      (\dim_use:N \l_ls_milestone_wrap_left_rail_dim,-1.28in) --
      (\dim_use:N \l_ls_milestone_wrap_end_dim,-1.28in);
  }

\cs_new_protected:Npn \ls_milestone_render:
  {
    \int_set:Nn \l_ls_milestone_count_int {\seq_count:N \l_ls_milestone_seq}
    \int_compare:nNnTF {\l_ls_milestone_count_int} < {1}
      {\msg_fatal:nne {beamerthemeLinearSpace}{milestone-count}{\int_use:N \l_ls_milestone_count_int}}
      {
        \int_compare:nNnT {\l_ls_milestone_count_int} > {10}
          {\msg_fatal:nne {beamerthemeLinearSpace}{milestone-count}{\int_use:N \l_ls_milestone_count_int}}
      }
    \bool_set:Nn \l_ls_milestone_compact_bool
      {\int_compare_p:nNn {\l_ls_milestone_count_int} > {5}}
    \bool_if:NTF \l_ls_milestone_compact_bool
      {
        \dim_set:Nn \l_ls_milestone_card_width_dim
          {(\linewidth - 0.56in) / 5}
        \def\ls@milestonemarkersize{0.35in}
        \def\ls@milestonemarkersizefont{11}
        \def\ls@milestonecornerradius{0.075in}
        \def\ls@milestoneactivityoffset{0.145in}
        \def\ls@milestoneactivityradius{0.027in}
        \def\ls@milestonecontentoffset{0.28in}
        \def\ls@milestonetitlesize{11.2}
        \def\ls@milestonetitleleading{13.0}
        \def\ls@milestonetitleslot{0.38in}
        \def\ls@milestonetitlegap{0.025in}
        \def\ls@milestonebodysize{9.2}
        \def\ls@milestonebodyleading{11.1}
        \def\ls@milestonebodyslot{0.48in}
        \def\ls@milestonedategap{0.045in}
        \def\ls@milestonedatepadding{2.5pt}
        \def\ls@milestonedateinset{0.18in}
        \def\ls@milestonedatesize{7.2}
        \def\ls@milestonedateleading{8.6}
      }
      {
        \dim_set:Nn \l_ls_milestone_card_width_dim
          {(\linewidth - 0.14in * (\l_ls_milestone_count_int - 1))
            / \l_ls_milestone_count_int}
        \dim_compare:nNnT {\l_ls_milestone_card_width_dim} > {3.15in}
          {\dim_set:Nn \l_ls_milestone_card_width_dim {3.15in}}
        \def\ls@milestonemarkersize{0.48in}
        \def\ls@milestonemarkersizefont{15}
        \def\ls@milestonecornerradius{0.10in}
        \def\ls@milestoneactivityoffset{0.205in}
        \def\ls@milestoneactivityradius{0.037in}
        \def\ls@milestonecontentoffset{0.39in}
        \def\ls@milestonetitlesize{15.5}
        \def\ls@milestonetitleleading{18.5}
        \def\ls@milestonetitleslot{0.56in}
        \def\ls@milestonetitlegap{0.065in}
        \def\ls@milestonebodysize{12.8}
        \def\ls@milestonebodyleading{15.8}
        \def\ls@milestonebodyslot{0.70in}
        \def\ls@milestonedategap{0.11in}
        \def\ls@milestonedatepadding{4.4pt}
        \def\ls@milestonedateinset{0.26in}
        \def\ls@milestonedatesize{9.7}
        \def\ls@milestonedateleading{11.5}
      }
    \dim_set:Nn \l_ls_milestone_step_dim
      {\l_ls_milestone_card_width_dim + 0.14in}
    \edef\ls@backgroundfile{\ls@resolvebackground{\ls@milestonebackground}}
    \tl_if_blank:eF {\ls@backgroundfile}{\ls@requirebackground{\ls@backgroundfile}}
    \edef\ls@backgroundopacity{\ls@milestoneoverlay}
    \edef\ls@backgroundxshift{\ls@milestonexshift}
    \edef\ls@backgroundyshift{\ls@milestoneyshift}
    \bool_if:NT \l_ls_milestone_compact_bool
      {\setbeamerfont{frametitle}{size=\fontsize{35}{38},series=\bfseries}}
    \begin{frame}[t]{\ls@milestonetitle}
      \tl_if_blank:eF {\ls@milestoneeyebrow}
        {\bool_if:NTF \l_ls_milestone_compact_bool
          {{\fontsize{11.5}{13.5}\selectfont\bfseries\color{LSDeckLime}
            \MakeUppercase{\ls@milestoneeyebrow}\par\vspace{0.07in}}}
          {{\fontsize{13}{16}\selectfont\bfseries\color{LSDeckLime}
            \MakeUppercase{\ls@milestoneeyebrow}\par\vspace{0.16in}}}}
      \centering
      \begin{tikzpicture}
        \bool_if:NTF \l_ls_milestone_compact_bool
          {
            \path[use~as~bounding~box]
              (0,-2.88in) rectangle (\linewidth,0.96in);
            \ls_milestone_connector:nn {5}{0.75in}
            \ls_milestone_connector:nn
              {\int_eval:n {\l_ls_milestone_count_int - 5}}{-1.28in}
            \ls_milestone_wrap_connector:
          }
          {
            \path[use~as~bounding~box]
              (0,-2.62in) rectangle (\linewidth,0.27in);
            \ls_milestone_connector:nn
              {\l_ls_milestone_count_int}{0in}
          }
        \seq_map_indexed_function:NN
          \l_ls_milestone_seq \ls_milestone_indexed:nn
      \end{tikzpicture}
    \end{frame}
  }

\cs_new_protected:Npn \ls_milestone_indexed:nn #1#2
  {\int_set:Nn \l_ls_milestone_index_int {#1} #2}

\NewDocumentEnvironment{LSMilestoneSlide}{O{} m +b}
  {
    \group_begin:
      \seq_clear:N \l_ls_milestone_seq
      \bool_set_true:N \l_ls_milestone_collecting_bool
      \def\ls@milestonebackground{}
      \def\ls@milestoneoverlay{0}
      \def\ls@milestonexshift{0in}
      \def\ls@milestoneyshift{0in}
      \def\ls@milestoneeyebrow{Roadmap}
      \def\ls@milestonetitle{#2}
      \pgfkeys{/ls/milestone-slide,#1}
      #3
      \bool_set_false:N \l_ls_milestone_collecting_bool
      \ls_milestone_render:
    \group_end:
  }
