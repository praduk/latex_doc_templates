        \vspace{0.035in}{\fontsize{6.8}{8}\selectfont\color{LSDeckOffWhite}
          \LSTitleBackgroundCreditText\par}%
      }%
    \end{minipage}
    \par\vfill
    \begin{minipage}{0.94\textwidth}
      \LSCompactMarkingNotices
    \end{minipage}
  }{%
    \vspace*{0.30in}
    % Keep the primary message in the quieter left-hand field of the default
    % full-bleed artwork.  A restrained PDF text stroke preserves contrast on
    % arbitrary bright backgrounds without dimming or paneling the image.
    \begin{minipage}{0.60\textwidth}
      \RaggedRight\hyphenpenalty=10000\exhyphenpenalty=10000
      \LSWordmarkOnDark[1.05in]\par
      \vspace{0.34in}
