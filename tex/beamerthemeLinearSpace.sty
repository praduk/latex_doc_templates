\NewDocumentCommand{\LSTeamMember}{O{LS} m m m +m}
  {
    \bool_if:NTF \l_ls_team_collecting_bool
      {\seq_put_right:Nn \l_ls_team_members_seq
        {\ls@teamcard{#1}{#2}{#3}{#4}{#5}}}
      {\msg_fatal:nn {beamerthemeLinearSpace}{team-outside}}
  }

\cs_new_protected:Npn \ls_team_cards:
  {
    \hbox_to_wd:nn {\l_ls_team_area_width_dim}
      {\seq_map_indexed_function:NN \l_ls_team_members_seq \ls_team_card_indexed:nn}
  }

\cs_new_protected:Npn \ls_team_card_indexed:nn #1#2
  {#2\int_compare:nNnT {#1} < {\l_ls_team_count_int}{\hfil}}

\cs_new_protected:Npn \ls_team_render:
  {
    \int_set:Nn \l_ls_team_count_int {\seq_count:N \l_ls_team_members_seq}
    \int_compare:nNnTF {\l_ls_team_count_int} < {2}
      {\msg_fatal:nne {beamerthemeLinearSpace}{team-count}{\int_use:N \l_ls_team_count_int}}
      {
        \int_compare:nNnT {\l_ls_team_count_int} > {4}
          {\msg_fatal:nne {beamerthemeLinearSpace}{team-count}{\int_use:N \l_ls_team_count_int}}
      }
    \dim_set:Nn \l_ls_team_area_width_dim {\linewidth}
    \def\ls@teammediawidth{1.47in}
    \tl_if_blank:eF {\ls@teammedia}
      {\dim_sub:Nn \l_ls_team_area_width_dim {1.65in}}
    \dim_set_eq:NN \l_ls_team_card_width_dim \l_ls_team_area_width_dim
    \dim_sub:Nn \l_ls_team_card_width_dim
      {0.13in * \int_eval:n {\l_ls_team_count_int - 1}}
    \dim_set:Nn \l_ls_team_card_width_dim
      {\l_ls_team_card_width_dim / \l_ls_team_count_int}
    \edef\ls@teamcardwidth{\dim_use:N \l_ls_team_card_width_dim}
    \int_compare:nNnTF {\l_ls_team_count_int} = {2}
      {
        \def\ls@teamphotoheight{1.15in}
        \def\ls@teamnamesize{21}
        \def\ls@teamnameleading{24}
      }
      {
        \def\ls@teamphotoheight{0.92in}
        \def\ls@teamnamesize{18}
        \def\ls@teamnameleading{21}
      }
    \edef\ls@backgroundfile{\ls@resolvebackground{\ls@teambackground}}
    \tl_if_blank:eF {\ls@backgroundfile}{\ls@requirebackground{\ls@backgroundfile}}
    \edef\ls@backgroundopacity{\ls@teamoverlay}
    \edef\ls@backgroundxshift{\ls@teamxshift}
    \edef\ls@backgroundyshift{\ls@teamyshift}
    \begin{frame}[t]{\ls@teamtitle}
      \tl_if_blank:eF {\ls@teameyebrow}
        {{\fontsize{13}{16}\selectfont\bfseries\color{LSDeckLime}
          \MakeUppercase{\ls@teameyebrow}\par\vspace{0.10in}}}
      \noindent
      \tl_if_blank:eTF {\ls@teammedia}
        {\ls_team_cards:}
        {
          \str_if_eq:eeTF {\ls@teammediaside}{left}
            {\ls@teammediapanel\hfill\ls_team_cards:}
            {\ls_team_cards:\hfill\ls@teammediapanel}
        }
    \end{frame}
  }

\NewDocumentEnvironment{LSTeamSlide}{O{} m +b}
  {
    \group_begin:
      \seq_clear:N \l_ls_team_members_seq
      \bool_set_true:N \l_ls_team_collecting_bool
      \def\ls@teambackground{}
      \def\ls@teamoverlay{0.52}
      \def\ls@teamxshift{0in}
      \def\ls@teamyshift{0in}
      \def\ls@teameyebrow{Team}
      \def\ls@teammedia{}
      \def\ls@teammediaside{left}
      \def\ls@teamtitle{#2}
      \pgfkeys{/ls/team-slide,#1}
      #3
      \bool_set_false:N \l_ls_team_collecting_bool
      \ls_team_render:
    \group_end:
  }
  {}
