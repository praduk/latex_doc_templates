% Named backgrounds are a convenience, never a closed list: every API below
% also accepts an arbitrary readable image path.  Independently sourced
% examples are registered alongside the owner-approved supplied library; the
% project provenance record remains authoritative for publication review.
\NewDocumentCommand{\LSDeclareBackground}{m m}{%
  \expandafter\def\csname ls@background@#1\endcsname{#2}%
}
\newcommand{\ls@resolvebackground}[1]{%
\ifcsname ls@background@#1\endcsname%
\csname ls@background@#1\endcsname%
\else%
#1%
\fi%
}
\NewExpandableDocumentCommand{\LSBackgroundPath}{m}{\ls@resolvebackground{#1}}

