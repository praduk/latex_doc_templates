    \ls_freeze_expanded:N \g_ls_controlled_office_tl
    \ls_freeze_expanded:N \g_ls_cui_categories_tl
    \ls_freeze_expanded:N \g_ls_limited_dissemination_tl
    \ls_freeze_expanded:N \g_ls_control_poc_tl
    \ls_freeze_expanded:N \g_ls_export_jurisdiction_tl
    \ls_freeze_expanded:N \g_ls_export_classification_tl
    \ls_freeze_expanded:N \g_ls_export_authorization_tl
    \ls_freeze_expanded:N \g_ls_export_destination_tl
    \ls_freeze_expanded:N \g_ls_export_end_user_tl
    \ls_freeze_expanded:N \g_ls_export_end_use_tl
    \ls_freeze_expanded:N \g_ls_export_contact_tl
    \ls_freeze_expanded:N \g_ls_export_review_date_tl
    \ls_freeze_expanded:N \g_ls_classified_by_tl
    \ls_freeze_expanded:N \g_ls_classification_reason_tl
    \ls_freeze_expanded:N \g_ls_derived_from_tl
    \ls_freeze_expanded:N \g_ls_declassify_on_tl
    \ls_freeze_expanded:N \g_ls_classified_cui_warning_tl
    \ls_freeze_expanded:N \g_ls_classified_cui_source_tl
    \ls_freeze_expanded:N \g_ls_classified_cui_contact_tl
    \ls_freeze_expanded:N \g_ls_distribution_category_tl
    \ls_freeze_expanded:N \g_ls_distribution_date_tl
    \ls_freeze_expanded:N \g_ls_distribution_office_tl
    \ls_freeze_expanded:N \g_ls_legacy_distribution_tl
    \ls_freeze_expanded:N \g_ls_custom_notice_tl
  }

\cs_new_protected:Npn \ls_prepare_document_banner:
  {
    \ls_canonicalize_banner:n {\tl_use:N \g_ls_banner_tl}
    \str_if_eq:VnT \g_ls_profile_tl {unclassified}
      {\tl_if_blank:VT \l_ls_banner_candidate_tl
        {\ls_canonicalize_banner:n {UNCLASSIFIED}}}
    \str_if_eq:VnT \g_ls_profile_tl {corporate}
      {
        \clist_if_in:NnT \g_ls_controls_clist {proprietary}
          {
            \tl_if_blank:VT \l_ls_banner_candidate_tl
              {
                \str_if_eq:VnTF \g_ls_proprietary_mode_tl {multi-owner}
                  {\ls_canonicalize_banner:n {PROPRIETARY,~SEE~TITLE~PAGE}}
                  {\ls_canonicalize_banner:n {LINEAR~SPACE~PROPRIETARY}}
              }
          }
      }
    \ls_validate_banner_profile:
    \ls_validate_banner_width:
    \tl_gset:Nx \g_ls_banner_tl {\exp_not:V \l_ls_banner_candidate_tl}
    \tl_gset:Nx \g_ls_document_banner_tl {\exp_not:V \l_ls_banner_candidate_tl}
  }

\cs_new_protected:Npn \ls_validate_distribution:
  {
    \tl_if_blank:VF \g_ls_legacy_distribution_tl
      {\ls_error:nn {Raw~distribution-statement~text~is~disabled}
        {Use~distribution-code~with~the~structured~category,~date,~and~office~fields;~use~custom-notice~for~non-DoD~text.}}
    \str_case:Vn \g_ls_distribution_code_tl
      {
        {none}
          {
            \ls_require_blank:Nn \g_ls_distribution_category_tl {distribution-category}
            \ls_require_blank:Nn \g_ls_distribution_date_tl {distribution-date}
            \ls_require_blank:Nn \g_ls_distribution_office_tl {distribution-office}
          }
        {A}
          {
            \bool_if:NF \g_ls_dod_distribution_authority_bool
              {\ls_error:nn {Distribution~Statement~A~requires~DoD~authority~confirmation}
                {Set~operator-confirms-dod-distribution-authority=true~only~after~the~controlling~DoD~office's~determination.}}
            \bool_if:NF \g_ls_public_release_approved_bool
              {\ls_error:nn {Distribution~Statement~A~requires~public-release~approval}
                {Set~public-release-approved=true~only~after~the~competent~authority~approves~release.}}
            \str_if_eq:VnF \g_ls_classification_tl {none}
              {\ls_error:nn {Distribution~Statement~A~cannot~mark~classified~output}
                {Use~the~controlling~DoD~office's~actual~B--F~determination.}}
            \clist_if_empty:NF \g_ls_controls_clist
              {\ls_error:nn {Distribution~Statement~A~cannot~accompany~declared~controls}
                {Remove~Statement~A~or~decontrol~only~through~the~authorized~release~process.}}
            \ls_require_blank:Nn \g_ls_distribution_category_tl {distribution-category}
            \ls_require_blank:Nn \g_ls_distribution_date_tl {distribution-date}
            \ls_require_blank:Nn \g_ls_distribution_office_tl {distribution-office}
          }
        {B}{\ls_validate_distribution_b_to_e:}
        {C}{\ls_validate_distribution_b_to_e:}
        {D}{\ls_validate_distribution_b_to_e:}
        {E}{\ls_validate_distribution_b_to_e:}
        {F}
          {
            \bool_if:NF \g_ls_dod_distribution_authority_bool
              {\ls_error:nn {DoD~Distribution~Statement~F~requires~authority~confirmation}
                {Set~operator-confirms-dod-distribution-authority=true~only~for~the~controlling~DoD~office's~determination.}}
            \ls_require_blank:Nn \g_ls_distribution_category_tl {distribution-category}
            \ls_require_nonblank:Nn \g_ls_distribution_date_tl {distribution-date}
            \ls_require_nonblank:Nn \g_ls_distribution_office_tl {distribution-office}
            \ls_validate_restricted_distribution_profile:
          }
      }
    \str_if_eq:VnTF \g_ls_distribution_code_tl {A}
      {}
      {\bool_if:NT \g_ls_public_release_approved_bool
        {\ls_error:nn {public-release-approved~applies~only~to~Distribution~Statement~A}
          {Remove~the~stale~assertion~or~select~Statement~A~after~actual~approval.}}}
    \str_if_eq:VnTF \g_ls_distribution_code_tl {none}
      {\bool_if:NT \g_ls_dod_distribution_authority_bool
        {\ls_error:nn {DoD~distribution-authority~confirmation~has~no~statement}
          {Remove~the~stale~assertion~or~configure~the~controlling~office's~B--F~determination.}}}
      {}
  }

\cs_new_protected:Npn \ls_validate_distribution_b_to_e:
  {
    \bool_if:NF \g_ls_dod_distribution_authority_bool
      {\ls_error:nn {A~DoD~distribution~statement~requires~authority~confirmation}
        {Set~operator-confirms-dod-distribution-authority=true~only~for~the~controlling~DoD~office's~determination.}}
    \ls_validate_distribution_categories:
    \ls_require_nonblank:Nn \g_ls_distribution_date_tl {distribution-date}
    \ls_require_nonblank:Nn \g_ls_distribution_office_tl {distribution-office}
    \ls_validate_restricted_distribution_profile:
  }

\cs_new_protected:Npn \ls_validate_distribution_categories:
  {
    \ls_require_nonblank:Nn \g_ls_distribution_category_tl {distribution-categories}
    \clist_set:NV \l_ls_distribution_categories_clist
      \g_ls_distribution_category_tl
    \int_compare:nNnT
      {\clist_count:N \l_ls_distribution_categories_clist} > {3}
      {\ls_error:nn {A~DoD~distribution~statement~has~more~than~three~reasons}
        {Use~one~to~three~controlling-office-approved~defense-category~headings.}}
    \clist_clear:N \l_ls_distribution_categories_canonical_clist
    \clist_map_inline:Nn \l_ls_distribution_categories_clist
      {
        \tl_set:Nn \l_tmpa_tl {##1}
        \tl_trim_spaces:N \l_tmpa_tl
        \ls_reject_placeholder:Nn \l_tmpa_tl {distribution-categories}
        \exp_args:NV \ls_validate_distribution_category:n \l_tmpa_tl
        \tl_set_eq:NN \l_tmpb_tl \l_tmpa_tl
        \str_if_eq:VnT \l_tmpb_tl {CTI}
          {\tl_set:Nn \l_tmpb_tl {Controlled~Technical~Information}}
        \clist_put_right:NV
          \l_ls_distribution_categories_canonical_clist \l_tmpb_tl
        \str_case:Vn \l_tmpa_tl
          {
            {Export~Controlled}
              {\bool_gset_true:N \g_ls_dod_export_technical_information_bool}
            {Critical~Technology}
              {\bool_gset_true:N \g_ls_dod_export_technical_information_bool}
            {Direct~Military~Support}
              {\bool_gset_true:N \g_ls_dod_export_technical_information_bool}
          }
      }
    \clist_set_eq:NN \l_tmpa_clist
      \l_ls_distribution_categories_canonical_clist
    \clist_remove_duplicates:N \l_tmpa_clist
    \int_compare:nNnF
      {\clist_count:N \l_tmpa_clist} =
      {\clist_count:N \l_ls_distribution_categories_canonical_clist}
      {\ls_error:nn {A~DoD~distribution~statement~repeats~a~defense~category}
        {List~each~controlling-office-approved~reason~once.}}
  }

\cs_new_protected:Npn \ls_validate_distribution_category_code:nn #1#2
  {
    \clist_set:Nn \l_tmpb_clist {#2}
    \clist_if_in:NVTF \l_tmpb_clist \g_ls_distribution_code_tl
      {}
      {\exp_args:Nx \ls_error:nn
        {Defense~category~'#1'~is~not~authorized~for~Distribution~Statement~\tl_use:N \g_ls_distribution_code_tl}
        {Use~the~current~DoDI~5230.24~category/code~matrix~and~the~controlling~office's~determination.}}
  }

\cs_new_protected:Npn \ls_validate_distribution_category:n #1
  {
    \str_case:nnF {#1}
      {
        {CTI}{\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Controlled~Technical~Information}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Contractor~Performance~Evaluation}
          {\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {Critical~Technology}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Direct~Military~Support}
          {\ls_validate_distribution_category_code:nn {#1}{E}}
        {Export~Controlled}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Foreign~Government~Information}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {IAs}{\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Operations~Security}
          {\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {Patents~and~Inventions}
          {\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {Proprietary~Business~Information}
          {\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {SBIR}{\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {Software~Documentation}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
        {Test~and~Evaluation}
          {\ls_validate_distribution_category_code:nn {#1}{B,E}}
        {Vulnerability~Information}
          {\ls_validate_distribution_category_code:nn {#1}{B,C,D,E}}
      }
      {\ls_error:nn {Unknown~DoD~defense-category~heading~'#1'}
        {Use~an~exact~current~DoDI~5230.24~Section~4.3~heading~approved~by~the~controlling~office.}}
  }

\cs_new_protected:Npn \ls_validate_restricted_distribution_profile:
  {
    \str_if_eq:VnTF \g_ls_classification_tl {none}
      {
        \str_if_eq:VnF \g_ls_profile_tl {cui-dod}
          {\ls_error:nn {Unclassified~DoD~Distribution~Statements~B--F~require~the~DoD~CUI~profile}
            {Use~profile=cui-dod~and~controls={cui};~DoDI~5230.24~subjects~such~material~to~DoD~CUI~handling.}}
        \clist_if_in:NnF \g_ls_controls_clist {cui}
          {\ls_error:nn {Unclassified~DoD~Distribution~Statements~B--F~require~controls={cui}}
            {Configure~the~DoD~CUI~fields~from~the~controlling~office's~determination.}}
      }
      {
        \str_if_eq:VnF \g_ls_profile_tl {classified-dod}
          {\ls_error:nn {A~classified~DoD~distribution~statement~requires~profile=classified-dod}
            {Use~the~DoD~classified~profile~only~inside~the~authorized~environment.}}
      }
  }

\cs_new_protected:Npn \ls_validate_dod_cti_category:
  {
    \bool_set_false:N \l_tmpa_bool
    \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
      {\bool_set_true:N \l_tmpa_bool}
    \bool_if:NT \l_tmpa_bool
      {
        \clist_if_in:NnT \g_ls_controls_clist {cui}
          {
            \clist_set:NV \l_tmpa_clist \g_ls_cui_categories_tl
            \clist_if_in:NnTF \l_tmpa_clist {CTI}
              {
                \str_if_eq:VnT \g_ls_distribution_code_tl {none}
                  {\ls_error:nn
                    {The~DoD~unclassified~CTI~category~requires~a~structured~distribution~statement}
                    {Configure~the~controlling~DoD~office's~Distribution~Statement~B,~C,~D,~E,~or~F~determination.}}
              }
              {
                \str_if_eq:VnF \g_ls_distribution_code_tl {none}
                  {
                    \str_if_eq:VnF \g_ls_distribution_code_tl {A}
                      {\ls_error:nn
                        {A~DoD~CUI~distribution~statement~requires~the~CTI~CUI~category}
                        {Include~the~exact~delimited~token~CTI~in~cui-categories~only~when~the~controlling~DoD~office~made~that~determination.}}
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \ls_validate_dod_export_technical_information:
  {
    \bool_if:NT \g_ls_dod_export_technical_information_bool
      {
        \bool_set_false:N \l_tmpa_bool
        \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
          {\bool_set_true:N \l_tmpa_bool}
        \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
          {\bool_set_true:N \l_tmpa_bool}
        \bool_if:NF \l_tmpa_bool
          {\ls_error:nn
            {DoD~export-controlled~technical~information~requires~a~DoD~profile}
            {Use~cui-dod~for~unclassified~CTI~or~classified-dod~for~classified~technical~information.}}

        \bool_set_false:N \l_tmpa_bool
        \clist_if_in:NnT \g_ls_controls_clist {ear}
          {\bool_set_true:N \l_tmpa_bool}
        \clist_if_in:NnT \g_ls_controls_clist {itar}
          {\bool_set_true:N \l_tmpa_bool}
        \bool_if:NF \l_tmpa_bool
          {\ls_error:nn
            {DoD~export-controlled~technical~information~requires~EAR~or~ITAR~review~metadata}
            {Add~the~reviewed~ear~or~itar~control~and~complete~all~export~fields.}}

        \str_if_eq:VnTF \g_ls_profile_tl {cui-dod}
          {
            % DoDI 5230.24 Section 3.4.i applies this B--E assignment and
            % reason rule to unclassified export-controlled CTI.
            \str_case:VnF \g_ls_distribution_code_tl
              {{B}{}{C}{}{D}{}{E}{}}
              {\ls_error:nn
                {Unclassified~DoD~export-controlled~CTI~requires~Distribution~Statement~B,~C,~D,~or~E}
                {Use~the~controlling~DoD~office's~authorized~statement;~Statement~A~and~F~do~not~satisfy~the~unclassified~CTI~rule.}}
            \clist_set:NV \l_ls_distribution_categories_clist
              \g_ls_distribution_category_tl
            \clist_if_in:NnF \l_ls_distribution_categories_clist {Export~Controlled}
              {\ls_error:nn
                {The~unclassified~DoD~distribution~reasons~must~include~Export~Controlled}
                {Add~the~exact~Export~Controlled~category~from~the~controlling~office's~determination.}}
          }
          {
            % Classified technical information follows the B--F rule in
            % Sections 3.3.a and 4.3.e(3). Statement F has no category field.
            \str_case:VnF \g_ls_distribution_code_tl
              {{B}{}{C}{}{D}{}{E}{}{F}{}}
              {\ls_error:nn
                {Classified~DoD~export-controlled~technical~information~requires~Distribution~Statement~B,~C,~D,~E,~or~F}
                {Use~the~controlling~DoD~office's~authorized~classified-information~distribution~determination.}}
          }
      }
  }

\cs_new_protected:Npn \ls_validate_dod_export_determination:
  {
    \bool_set_false:N \l_tmpa_bool
    \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
      {\bool_set_true:N \l_tmpa_bool}
    \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
      {\bool_set_true:N \l_tmpa_bool}
    \bool_if:NTF \l_tmpa_bool
      {
        \bool_set_false:N \l_tmpb_bool
        \clist_if_in:NnT \g_ls_controls_clist {ear}
          {\bool_set_true:N \l_tmpb_bool}
        \clist_if_in:NnT \g_ls_controls_clist {itar}
          {\bool_set_true:N \l_tmpb_bool}
        \bool_if:NT \l_tmpb_bool
          {
            \bool_if:NF \g_ls_dod_export_technical_information_bool
              {
                \tl_if_blank:VT \g_ls_dod_export_determination_tl
                  {\ls_error:nn
                    {A~DoD~EAR/ITAR~profile~requires~an~explicit~export-controlled-technical-information~determination}
                    {Set~dod-export-controlled-technical-information=true~or~false~only~from~the~controlling~DoD~office's~review.}}
              }
          }
        \str_if_eq:VnT \g_ls_dod_export_determination_tl {does-not-apply}
          {
            \bool_if:NT \g_ls_dod_export_technical_information_bool
              {\ls_error:nn
                {The~explicit~DoD~export~determination~conflicts~with~a~definitionally~export-controlled~defense~category}
                {Use~the~controlling~office's~consistent~determination~and~approved~distribution~reasons.}}
          }
        \bool_if:NF \l_tmpb_bool
          {
            \bool_if:NF \g_ls_dod_export_technical_information_bool
              {
                \tl_if_blank:VF \g_ls_dod_export_determination_tl
                  {\ls_error:nn
                    {A~DoD~export~determination~has~no~EAR/ITAR~control~or~export-controlled~defense~category}
                    {Remove~the~stale~determination~or~configure~the~reviewed~export~layer.}}
              }
          }
      }
      {
        \tl_if_blank:VF \g_ls_dod_export_determination_tl
          {\ls_error:nn {The~DoD~export~determination~key~requires~a~DoD~profile}
            {Remove~the~stale~key~or~select~the~authority-directed~DoD~profile.}}
      }
  }

\cs_new_protected:Npn \ls_validate_export_jurisdiction:
  {
    \bool_set_false:N \l_ls_export_ear_bool
    \bool_set_false:N \l_ls_export_itar_bool
    \clist_if_in:NnT \g_ls_controls_clist {ear}
      {\bool_set_true:N \l_ls_export_ear_bool}
    \clist_if_in:NnT \g_ls_controls_clist {itar}
      {\bool_set_true:N \l_ls_export_itar_bool}
    \bool_if:NTF \l_ls_export_ear_bool
      {
        \bool_if:NTF \l_ls_export_itar_bool
          {
            \str_if_eq:VnF \g_ls_export_jurisdiction_tl {EAR~and~ITAR}
              {\ls_error:nn {Export~jurisdiction~does~not~match~controls={ear,itar}}
                {Use~export-jurisdiction={EAR~and~ITAR}~only~after~both~reviews~apply.}}
          }
          {
            \str_if_eq:VnF \g_ls_export_jurisdiction_tl {EAR}
              {\ls_error:nn {Export~jurisdiction~does~not~match~controls={ear}}
                {Use~export-jurisdiction={EAR},~or~correct~the~reviewed~control~set.}}
          }
      }
      {
        \str_if_eq:VnF \g_ls_export_jurisdiction_tl {ITAR}
          {\ls_error:nn {Export~jurisdiction~does~not~match~controls={itar}}
            {Use~export-jurisdiction={ITAR},~or~correct~the~reviewed~control~set.}}
      }
  }

\NewDocumentCommand{\LSValidateBanner}{m}{\ls_validate_banner_value:n {#1}}

% Validate a CUI-only banner for an individual slide without changing the
% document's validated overall banner. The presentation renderer consumes the
% result immediately through \LSValidatedBannerText.
\cs_new_protected:Npn \ls_validate_cui_only_banner:n #1
  {
    \clist_if_in:NnTF \g_ls_controls_clist {cui}
      {
        \ls_canonicalize_banner:n {#1}
        \tl_if_blank:VTF \l_ls_banner_candidate_tl
          {\ls_error:nn {A~CUI-only~slide~banner~cannot~be~blank}
            {Use~the~exact~uppercase~CUI~or~CONTROLLED~banner~approved~for~the~slide.}}
          {}
        \ls_require_uppercase_banner:
        \regex_match:nVTF
          {\A \s* (CUI|CONTROLLED)
            ( \s* // \s* [A-Z0-9-]+ ( \s* / \s* [A-Z0-9-]+ )* )*
            \s* \Z}
          \l_ls_banner_upper_tl
          {}
          {\ls_error:nn {The~CUI-only~slide~banner~has~invalid~syntax}
            {Use~the~exact~uppercase~CUI~or~CONTROLLED~banner~from~the~controlling~authority.}}
        \regex_match:nVTF
          {TOP \s+ SECRET|SECRET|CONFIDENTIAL|UNCLASSIFIED}
          \l_ls_banner_upper_tl
          {\ls_error:nn {A~CUI-only~slide~banner~cannot~contain~a~classification~term}
            {Use~only~the~approved~CUI~control~and~dissemination~markings~for~that~slide.}}
          {}
        \ls_validate_banner_width:
      }
      {\ls_error:nn {A~CUI-only~slide~banner~requires~controls={cui}}
        {Add~cui~only~when~authorized,~or~do~not~use~a~CUI-only~slide~banner.}}
  }

\NewDocumentCommand{\LSValidateCUIOnlyBanner}{m}
  {\ls_validate_cui_only_banner:n {#1}}

\cs_new_protected:Npn \ls_validate_markings:
  {
    \ls_freeze_marking_fields:
    \tl_if_blank:VF \g_ls_classified_cui_warning_tl
      {\ls_error:nn {Raw~classified-cui-warning~text~is~disabled}
        {Use~classified-cui-source~and~classified-cui-contact;~the~package~renders~the~prescribed~DoD~warning~structure.}}

    \str_if_eq:VnTF \g_ls_profile_tl {unclassified}
      {\tl_gset:Nn \g_ls_banner_color_tl {LSUnclassifiedGreen}}
      {
        \str_if_eq:VnTF \g_ls_classification_tl {top-secret}
          {\tl_gset:Nn \g_ls_banner_color_tl {LSOrange}}
          {
            \str_if_eq:VnTF \g_ls_classification_tl {secret}
              {\tl_gset:Nn \g_ls_banner_color_tl {LSRed}}
              {
                \str_if_eq:VnTF \g_ls_classification_tl {confidential}
                  {\tl_gset:Nn \g_ls_banner_color_tl {LSBlue}}
                  {
                    \clist_if_in:NnTF \g_ls_controls_clist {cui}
                      {\tl_gset:Nn \g_ls_banner_color_tl {LSPurple}}
                      {\tl_gset:Nn \g_ls_banner_color_tl {LSBlue}}
                  }
              }
          }
      }

    \clist_map_inline:Nn \g_ls_controls_clist
      {
        \str_case:nnF {##1}
          {
            {proprietary}{}
            {ear}{}
            {itar}{}
            {cui}{}
          }
          {\ls_error:nn {Unknown~control~token~'##1'}
            {Use~only~proprietary,~ear,~itar,~or~cui.}}
      }

    \str_if_eq:VnT \g_ls_profile_tl {uncontrolled}
      {
        \clist_if_empty:NF \g_ls_controls_clist
          {\ls_error:nn {The~uncontrolled~profile~cannot~declare~controls}
            {Choose~unclassified,~corporate,~a~CUI~profile,~or~a~classified~profile.}}
      }

    \ls_validate_proprietary_owners:

    \ls_profile_cui:T
      {
        \clist_if_in:NnF \g_ls_controls_clist {cui}
          {\ls_error:nn {A~CUI~profile~requires~controls={cui}}
            {Add~cui~to~the~controls~list~only~when~authorized.}}
      }

    \ls_profile_classified:TF
      {
        \str_if_eq:VnT \g_ls_classification_tl {none}
          {\ls_error:nn {A~classified~profile~requires~a~classification~level}
            {Choose~classification=confidential,~secret,~or~top-secret.}}
        \bool_if:NF \g_ls_authorized_classified_bool
          {\ls_error:nn {Classified~output~requires~an~authorized~classified~system}
            {Set~operator-confirms-classified-environment=true~only~inside~the
             approved~environment~and~after~classification~review.}}
        \ls_require_nonblank:Nn \g_ls_classified_by_tl {classified-by}
        \ls_require_nonblank:Nn \g_ls_declassify_on_tl {declassify-on}
        \str_if_eq:VnTF \g_ls_authority_type_tl {original}
          {
            \ls_require_nonblank:Nn \g_ls_classification_reason_tl {classification-reason}
            \ls_require_blank:Nn \g_ls_derived_from_tl {derived-from}
            \bool_if:NF \g_ls_oca_acknowledged_bool
              {\ls_error:nn {Original~classification~requires~OCA~confirmation}
                {Set~original-classification-authority-confirmed=true~only~for
                 an~authorized~Original~Classification~Authority~decision.}}
          }
          {
            \str_if_eq:VnTF \g_ls_authority_type_tl {derivative}
              {
                \ls_require_nonblank:Nn \g_ls_derived_from_tl {derived-from}
                \ls_require_blank:Nn \g_ls_classification_reason_tl {classification-reason}
                \bool_if:NT \g_ls_oca_acknowledged_bool
                  {\ls_error:nn {Original-classification-authority~confirmation~does~not~apply~to~derivative~classification}
                    {Remove~the~stale~confirmation~or~use~an~authorized~original-classification~decision.}}
              }
              {\ls_error:nn {Classified~output~requires~authority-type}
                {Choose~authority-type=original~or~derivative~and~supply~the
                 corresponding~authorized~fields.}}
          }
      }
      {
        \str_if_eq:VnF \g_ls_classification_tl {none}
          {\ls_error:nn {A~classification~level~requires~a~classified~profile}
            {Choose~classified-general~or~classified-dod.}}
        \ls_require_blank:Nn \g_ls_classified_by_tl {classified-by}
        \ls_require_blank:Nn \g_ls_classification_reason_tl {classification-reason}
        \ls_require_blank:Nn \g_ls_derived_from_tl {derived-from}
        \ls_require_blank:Nn \g_ls_declassify_on_tl {declassify-on}
        \ls_require_blank:Nn \g_ls_classified_cui_source_tl {classified-cui-source}
        \ls_require_blank:Nn \g_ls_classified_cui_contact_tl {classified-cui-contact}
        \str_if_eq:VnF \g_ls_authority_type_tl {none}
          {\ls_error:nn {Classification~authority-type~does~not~apply~to~unclassified~output}
            {Use~authority-type=none~unless~an~authorized~classified~profile~is~selected.}}
        \bool_if:NT \g_ls_oca_acknowledged_bool
          {\ls_error:nn {Original-classification-authority~confirmation~does~not~apply~to~unclassified~output}
            {Remove~the~stale~confirmation.}}
        \bool_if:NT \g_ls_authorized_classified_bool
          {\ls_error:nn {Classified-environment~confirmation~does~not~apply~to~unclassified~output}
            {Remove~the~stale~operator~confirmation.}}
      }

    \ls_controlled_content:T
      {
        \bool_if:NF \g_ls_authorized_controlled_bool
          {
            \ls_error:nn
              {Controlled-content~markings~require~an~authorized~system}
              {Set~operator-confirms-controlled-environment=true~only~after
               confirming~the~contract,~authorization,~people,~and~system.}
          }
      }
    \ls_controlled_content:F
      {
        \bool_if:NT \g_ls_authorized_controlled_bool
          {\ls_error:nn {Controlled-environment~confirmation~has~no~controlled~content}
            {Remove~the~stale~operator~confirmation~or~configure~the~reviewed~CUI/EAR/ITAR~control.}}
      }

    \clist_if_in:NnT \g_ls_controls_clist {cui}
      {
        \ls_require_nonblank:Nn \g_ls_controlled_by_tl {controlled-by}
        \ls_require_nonblank:Nn \g_ls_cui_categories_tl {cui-categories}
        \ls_require_nonblank:Nn \g_ls_control_poc_tl {control-poc}
        \ls_profile_cui:F
          {
            \ls_profile_classified:F
              {\ls_error:nn {CUI~requires~a~CUI~or~classified~profile}
                {Choose~the~profile~specified~by~the~controlling~authority.}}
          }
        \ls_profile_classified:T
          {
            \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
              {
                \ls_require_nonblank:Nn \g_ls_controlled_office_tl {controlled-office}
                \ls_require_nonblank:Nn \g_ls_classified_cui_source_tl {classified-cui-source}
              }
          }
      }

    \clist_if_in:NnF \g_ls_controls_clist {cui}
      {
        \ls_require_blank:Nn \g_ls_controlled_by_tl {controlled-by}
        \ls_require_blank:Nn \g_ls_controlled_office_tl {controlled-office}
        \ls_require_blank:Nn \g_ls_cui_categories_tl {cui-categories}
        \ls_require_blank:Nn \g_ls_limited_dissemination_tl
          {distribution-dissemination-control}
        \ls_require_blank:Nn \g_ls_control_poc_tl {control-poc}
      }

    \bool_set_false:N \l_tmpa_bool
    \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
      {\bool_set_true:N \l_tmpa_bool}
    \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
      {\bool_set_true:N \l_tmpa_bool}
    \bool_if:NF \l_tmpa_bool
      {\ls_require_blank:Nn \g_ls_controlled_office_tl {controlled-office}}

    \str_if_eq:VnF \g_ls_profile_tl {classified-dod}
      {
        \ls_require_blank:Nn \g_ls_classified_cui_warning_tl {classified-cui-warning}
        \ls_require_blank:Nn \g_ls_classified_cui_source_tl {classified-cui-source}
        \ls_require_blank:Nn \g_ls_classified_cui_contact_tl {classified-cui-contact}
      }
    \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
      {\clist_if_in:NnF \g_ls_controls_clist {cui}
        {
          \ls_require_blank:Nn \g_ls_classified_cui_source_tl {classified-cui-source}
          \ls_require_blank:Nn \g_ls_classified_cui_contact_tl {classified-cui-contact}
        }}

    \clist_if_in:NnTF \g_ls_controls_clist {ear}
      {\bool_set_true:N \l_tmpa_bool}
      {
        \clist_if_in:NnTF \g_ls_controls_clist {itar}
          {\bool_set_true:N \l_tmpa_bool}
          {\bool_set_false:N \l_tmpa_bool}
      }
    \bool_if:NT \l_tmpa_bool
      {
        \ls_require_nonblank:Nn \g_ls_export_jurisdiction_tl {export-jurisdiction}
        \ls_require_nonblank:Nn \g_ls_export_classification_tl {export-classification}
        \ls_require_nonblank:Nn \g_ls_export_authorization_tl {export-authorization}
        \ls_require_nonblank:Nn \g_ls_export_destination_tl {export-destination}
        \ls_require_nonblank:Nn \g_ls_export_end_user_tl {export-end-user}
        \ls_require_nonblank:Nn \g_ls_export_end_use_tl {export-end-use}
        \ls_require_nonblank:Nn \g_ls_export_contact_tl {export-contact}
        \ls_require_nonblank:Nn \g_ls_export_review_date_tl {export-review-date}
        \ls_validate_export_jurisdiction:
      }
    \bool_if:NF \l_tmpa_bool
      {
        \ls_require_blank:Nn \g_ls_export_jurisdiction_tl {export-jurisdiction}
        \ls_require_blank:Nn \g_ls_export_classification_tl {export-classification}
        \ls_require_blank:Nn \g_ls_export_authorization_tl {export-authorization}
        \ls_require_blank:Nn \g_ls_export_destination_tl {export-destination}
        \ls_require_blank:Nn \g_ls_export_end_user_tl {export-end-user}
        \ls_require_blank:Nn \g_ls_export_end_use_tl {export-end-use}
        \ls_require_blank:Nn \g_ls_export_contact_tl {export-contact}
        \ls_require_blank:Nn \g_ls_export_review_date_tl {export-review-date}
      }

    \ls_validate_distribution:
    \ls_validate_dod_export_determination:
    \ls_validate_dod_cti_category:
    \ls_validate_dod_export_technical_information:

    \clist_if_in:NnT \g_ls_controls_clist {cui}
      {
        \bool_set_false:N \l_tmpa_bool
        \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
          {\bool_set_true:N \l_tmpa_bool}
        \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
          {\bool_set_true:N \l_tmpa_bool}
        \bool_if:NT \l_tmpa_bool
          {
            \ls_require_nonblank:Nn \g_ls_controlled_office_tl {controlled-office}
            \str_if_eq:VnT \g_ls_distribution_code_tl {none}
              {\ls_require_nonblank:Nn \g_ls_limited_dissemination_tl
                {distribution-dissemination-control}}
          }
      }

    \ls_prepare_document_banner:

    % A preamble page override may have been entered before later
    % \LSMarkingSetup calls selected the final profile. Revalidate and freeze it
    % against that final state so setup order cannot bypass banner rules.
    \bool_if:NT \g_ls_page_banner_override_bool
      {
        \ls_validate_banner_value:n
          {\tl_use:N \g_ls_page_banner_override_tl}
        \tl_gset:Nx \g_ls_page_banner_override_tl
          {\exp_not:V \l_ls_banner_candidate_tl}
        \bool_set_false:N \l_tmpa_bool
        \ls_profile_cui:T {\bool_set_true:N \l_tmpa_bool}
        \str_if_eq:VnT \g_ls_profile_tl {classified-general}
          {\clist_if_in:NnT \g_ls_controls_clist {cui}
            {\bool_set_true:N \l_tmpa_bool}}
        \bool_if:NT \l_tmpa_bool
          {
            \tl_if_eq:NNTF
              \g_ls_page_banner_override_tl \g_ls_document_banner_tl
              {}
              {\ls_error:nn
                {A~CUI-bearing~document~must~use~one~inclusive~banner~on~every~page}
                {A~preamble~page~override~must~exactly~match~the~final~validated~document~banner.}}
          }
      }

    \bool_if:NF \g_ls_render_page_banners_bool
      {
        \tl_if_blank:VF \g_ls_document_banner_tl
          {\bool_if:NF \g_ls_alternate_banner_renderer_bool
            {\ls_error:nn {Marked~output~has~no~registered~banner~renderer}
              {Enable~page~banners~or~use~the~Linear~Space~presentation~theme.}}}
      }
  }

\AtBeginDocument{\ls_validate_markings:\bool_gset_true:N \g_ls_config_frozen_bool}

