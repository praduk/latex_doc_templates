                align=center,
                text~width=\dimexpr\paperwidth-12pt\relax,
                font=\sffamily\bfseries\fontsize{7.5}{8.5}\selectfont,
                inner~sep=0pt
              ] at ([yshift=-0.09in]current~page.north)
                {\tl_use:N \l_tmpa_tl};
              \path[
                fill=\ls_banner_color:,
                draw=none
              ]
                (current~page.south~west)
                rectangle
                ([yshift=0.18in]current~page.south~east);
              \node[
                anchor=center,
                text=white,
                align=center,
                text~width=\dimexpr\paperwidth-12pt\relax,
                font=\sffamily\bfseries\fontsize{7.5}{8.5}\selectfont,
                inner~sep=0pt
              ] at ([yshift=0.09in]current~page.south)
                {\tl_use:N \l_tmpa_tl};
            \end{tikzpicture}
          }
      }
    \bool_gset_false:N \g_ls_page_banner_override_bool
    \tl_gclear:N \g_ls_page_banner_override_tl
  }
