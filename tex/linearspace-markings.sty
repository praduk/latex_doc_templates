          {\ls_error:nn {Required~title-page~or~disclosure~notices~were~not~rendered}
            {Use~the~class~title~macro~or~\string\LSMarkingNotices;~the~stock
             Beamer~title~page~renders~complete~compact~cover~notices.}}
      }
    \bool_if:NT \g_ls_dod_export_technical_information_bool
      {
        \bool_if:NF \g_ls_dod_release_notice_rendered_bool
          {\ls_error:nn {Required~DoDD~5230.25~release~notice~was~not~rendered}
            {Use~the~stock~document~title~macro~or~render~\string\LSDoDReleaseNotice~with~the~disseminated~information.}}
      }
  }
\AtEndDocument{\ls_validate_required_notices:}

