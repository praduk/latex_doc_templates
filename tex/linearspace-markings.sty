\cs_new:Npn \ls_resolved_banner:
  {
    \tl_if_blank:VTF \g_ls_banner_tl
      {
        \str_if_eq:VnTF \g_ls_profile_tl {unclassified}
          {UNCLASSIFIED}
          {
            \str_if_eq:VnTF \g_ls_profile_tl {corporate}
              {
                \clist_if_in:NnTF \g_ls_controls_clist {proprietary}
                  {
                    \str_if_eq:VnTF \g_ls_proprietary_mode_tl {multi-owner}
                      {PROPRIETARY,~SEE~TITLE~PAGE}
                      {LINEAR~SPACE~PROPRIETARY}
                  }
                  {}
              }
              {}
          }
      }
      {\tl_use:N \g_ls_banner_tl}
  }

\cs_new:Npn \ls_banner_color: {\tl_use:N \g_ls_banner_color_tl}

