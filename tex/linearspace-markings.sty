\NewDocumentCommand{\LSMarkingSetup}{m}
  {
    \bool_if:NTF \g_ls_config_frozen_bool
      {\ls_error:nn {Marking~configuration~is~frozen}
        {Place~all~\string\LSMarkingSetup~calls~in~the~preamble.}}
      {\keys_set:nn {linearspace/markings}{#1}}
  }

\msg_new:nnnn {linearspace-markings}{fatal}{#1}{#2}
\cs_new_protected:Npn \ls_error:nn #1#2
  {\msg_fatal:nnnn {linearspace-markings}{fatal}{#1}{#2}}

\cs_new_protected:Npn \ls_freeze_expanded:N #1
  {
    \tl_set:Nx \l_tmpa_tl {\tl_use:N #1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_gset:Nx #1 {\exp_not:V \l_tmpa_tl}
  }

\cs_new_protected:Npn \ls_reject_placeholder:Nn #1#2
  {
    \tl_set:Nx \l_ls_validation_string_tl
      {\tl_upper_case:n {\tl_to_str:V #1}}
    \regex_match:nVTF
      {\A \s* ( \[ .* \] | YYYY-MM-DD | TBD | TODO | REPLACE ( \s+ ME )? ) \s* \Z}
      \l_ls_validation_string_tl
      {\ls_error:nn {Required~marking~field~'#2'~contains~a~placeholder}
        {Replace~the~placeholder~with~the~reviewed~value~before~building~marked~output.}}
      {}
  }

\cs_new_protected:Npn \ls_require_nonblank:Nn #1#2
  {
    \ls_freeze_expanded:N #1
    \tl_if_blank:VTF #1
      {\ls_error:nn {Required~marking~field~'#2'~is~blank}
        {Supply~the~reviewed~field~through~\string\LSMarkingSetup.}}
      {\ls_reject_placeholder:Nn #1 {#2}}
  }

\cs_new_protected:Npn \ls_require_blank:Nn #1#2
  {
    \ls_freeze_expanded:N #1
    \tl_if_blank:VF #1
      {\ls_error:nn {Marking~field~'#2'~does~not~apply}
        {Remove~the~field~or~select~the~profile~and~structured~option~that~requires~it.}}
  }

\cs_generate_variant:Nn \prop_if_in:NnTF {NV}
\cs_generate_variant:Nn \prop_gput:Nnn {NVV}

% Multi-owner proprietary legends are declarations, rather than a comma-list
% key, so each reviewed legend remains paired with exactly one named owner.
% Declarations are order independent with respect to \LSMarkingSetup, but the
% complete registry is validated and frozen when the document begins.
\NewDocumentCommand{\LSDeclareProprietaryOwner}{m m}
  {
    \bool_if:NTF \g_ls_config_frozen_bool
      {\ls_error:nn {Proprietary-owner~declarations~are~frozen}
        {Place~every~\string\LSDeclareProprietaryOwner~call~in~the~preamble.}}
      {
        \tl_set:Nx \l_tmpa_tl {#1}
        \tl_trim_spaces:N \l_tmpa_tl
        \tl_if_blank:VTF \l_tmpa_tl
          {\ls_error:nn {Proprietary~owner~name~is~blank}
            {Supply~the~reviewed~legal~name~of~the~proprietary-data~owner.}}
          {\ls_reject_placeholder:Nn \l_tmpa_tl {proprietary-owner}}

        \tl_set:Nx \l_tmpc_tl {#2}
        \tl_trim_spaces:N \l_tmpc_tl
        \tl_if_blank:VTF \l_tmpc_tl
          {\ls_error:nn {Proprietary~legend~or~disclosure~is~blank}
            {Supply~the~reviewed~legend~or~disclosure~for~this~owner.}}
          {\ls_reject_placeholder:Nn \l_tmpc_tl {proprietary-owner-legend}}

        \tl_set:Nx \l_tmpb_tl
          {\tl_upper_case:n {\tl_to_str:V \l_tmpa_tl}}
        \regex_replace_all:nnN {\s+} {~} \l_tmpb_tl
        \prop_if_in:NVTF \g_ls_proprietary_owner_display_prop \l_tmpb_tl
          {\exp_args:Nx \ls_error:nn
            {Proprietary~owner~'\tl_to_str:V \l_tmpa_tl'~is~declared~more~than~once}
            {Declare~each~owner~once~and~attach~one~reviewed~legend~or~disclosure.}}
          {
            \seq_gput_right:NV \g_ls_proprietary_owner_keys_seq \l_tmpb_tl
            \prop_gput:NVV
              \g_ls_proprietary_owner_display_prop \l_tmpb_tl \l_tmpa_tl
            \prop_gput:NVV
              \g_ls_proprietary_owner_legend_prop \l_tmpb_tl \l_tmpc_tl
          }
      }
  }

\cs_new_protected:Npn \ls_validate_proprietary_owners:
  {
    \str_if_eq:VnTF \g_ls_proprietary_mode_tl {multi-owner}
      {
        \clist_if_in:NnF \g_ls_controls_clist {proprietary}
          {\ls_error:nn {Multi-owner~proprietary~mode~requires~controls={proprietary}}
            {Add~the~proprietary~control~only~when~the~declared~owners'~reviewed~legends~apply.}}
        \int_compare:nNnT
          {\seq_count:N \g_ls_proprietary_owner_keys_seq} < {2}
          {\ls_error:nn {Multi-owner~proprietary~mode~requires~at~least~two~owners}
            {Declare~each~owner~and~its~reviewed~legend~with~\string\LSDeclareProprietaryOwner.}}
      }
      {
        \seq_if_empty:NF \g_ls_proprietary_owner_keys_seq
          {\ls_error:nn {Proprietary-owner~declarations~require~proprietary-mode=multi-owner}
            {Remove~the~declarations~for~single-owner~output,~or~select~multi-owner~mode~with~at~least~two~reviewed~owners.}}
      }
  }

\prg_new_conditional:Npnn \ls_profile_classified: {T,F,TF}
  {
    \str_if_eq:VnTF \g_ls_profile_tl {classified-general}
      {\prg_return_true:}
      {
        \str_if_eq:VnTF \g_ls_profile_tl {classified-dod}
          {\prg_return_true:}
          {\prg_return_false:}
      }
  }

\prg_new_conditional:Npnn \ls_profile_cui: {T,F,TF}
  {
    \str_if_eq:VnTF \g_ls_profile_tl {cui-general}
      {\prg_return_true:}
      {
        \str_if_eq:VnTF \g_ls_profile_tl {cui-dod}
          {\prg_return_true:}
          {\prg_return_false:}
      }
  }

\prg_new_conditional:Npnn \ls_controlled_content: {T,F,TF}
  {
    \clist_if_in:NnTF \g_ls_controls_clist {cui}
      {\prg_return_true:}
      {
        \clist_if_in:NnTF \g_ls_controls_clist {ear}
          {\prg_return_true:}
          {
            \clist_if_in:NnTF \g_ls_controls_clist {itar}
              {\prg_return_true:}
              {\prg_return_false:}
          }
      }
  }

\cs_generate_variant:Nn \regex_match:nnTF {nV}
\cs_generate_variant:Nn \tl_if_in:nnTF {VV}
\cs_generate_variant:Nn \clist_set:Nn {NV}
\cs_generate_variant:Nn \clist_if_in:NnTF {NV}

\cs_new_protected:Npn \ls_canonicalize_banner:n #1
  {
    \tl_set:Nx \l_ls_banner_candidate_tl {#1}
    \tl_trim_spaces:N \l_ls_banner_candidate_tl
    \tl_map_inline:Nn \l_ls_banner_candidate_tl
      {
        \token_if_cs:NT ##1
          {\ls_error:nn {Banner~text~must~be~literal~plain~text}
            {Do~not~place~macros~or~formatting~commands~in~banner-text~or~a~runtime~banner.}}
      }
    \tl_set:Nx \l_ls_banner_string_tl
      {\tl_to_str:V \l_ls_banner_candidate_tl}
    \tl_set:Nx \l_ls_banner_upper_tl
      {\tl_upper_case:n {\tl_to_str:V \l_ls_banner_candidate_tl}}
  }

\cs_new_protected:Npn \ls_require_uppercase_banner:
  {
    \tl_if_eq:NNTF \l_ls_banner_string_tl \l_ls_banner_upper_tl
      {}
      {\ls_error:nn {Official~banner~text~must~use~uppercase~letters}
        {Copy~the~exact~uppercase~banner~from~the~controlling~authority.}}
  }

\cs_new_protected:Npn \ls_reject_classification_words:
  {
    \regex_match:nVTF {TOP \s+ SECRET|SECRET|CONFIDENTIAL} \l_ls_banner_upper_tl
      {\ls_error:nn {An~unclassified~profile~cannot~render~a~classification~banner}
        {Remove~the~reserved~classification~word~or~select~an~authorized~classified~profile.}}
      {}
  }

\cs_new_protected:Npn \ls_validate_banner_width:
  {
    \tl_if_blank:VF \l_ls_banner_candidate_tl
      {
        \hbox_set:Nn \l_ls_banner_measure_box
          {\normalfont\sffamily\bfseries\fontsize{8.5}{9.5}\selectfont
           \tl_use:N \l_ls_banner_candidate_tl}
        \dim_compare:nNnT
          {\box_wd:N \l_ls_banner_measure_box} > {\paperwidth - 12pt}
          {\ls_error:nn {The~mandatory~banner~is~wider~than~the~page~or~slide}
            {Shorten~only~as~authorized;~the~template~will~not~crop~or~silently~shrink~mandatory~text.}}
      }
  }

\cs_new_protected:Npn \ls_validate_banner_profile:
  {
    \str_case:Vn \g_ls_profile_tl
      {
        {uncontrolled}
          {
            \tl_if_blank:VF \l_ls_banner_candidate_tl
              {\ls_error:nn {The~uncontrolled~profile~requires~a~blank~banner}
                {Use~a~controlled,~corporate,~CUI,~or~classified~profile~only~when~authorized.}}
          }
        {unclassified}
          {
            \ls_require_uppercase_banner:
            \str_if_eq:VnF \l_ls_banner_string_tl {UNCLASSIFIED}
              {\ls_error:nn {The~unclassified~profile~requires~the~exact~banner~UNCLASSIFIED}
                {Use~UNCLASSIFIED~only~when~the~document~contains~no~CUI~or~classified~information.}}
          }
        {corporate}
          {
            \clist_if_in:NnTF \g_ls_controls_clist {proprietary}
              {
                \str_if_eq:VnTF \g_ls_proprietary_mode_tl {multi-owner}
                  {
                    \str_if_eq:VnF \l_ls_banner_string_tl
                      {PROPRIETARY,~SEE~TITLE~PAGE}
                      {\ls_error:nn {The~multi-owner~corporate~proprietary~banner~must~be~exact}
                        {Use~PROPRIETARY,~SEE~TITLE~PAGE;~the~title-page~notice~lists~each~owner~and~reviewed~legend.}}
                  }
                  {
                    \str_if_eq:VnF \l_ls_banner_string_tl {LINEAR~SPACE~PROPRIETARY}
                      {\ls_error:nn {The~corporate~proprietary~banner~must~be~exact}
                        {Use~LINEAR~SPACE~PROPRIETARY;~put~other~handling~text~in~the~appropriate~notice.}}
                  }
              }
              {
                \tl_if_blank:VF \l_ls_banner_candidate_tl
                  {\ls_error:nn {A~non-proprietary~corporate~profile~requires~a~blank~banner}
                    {EAR~and~ITAR~are~not~universal~page-banner~markings.}}
              }
            \ls_reject_classification_words:
            \regex_match:nVTF {CUI|CONTROLLED} \l_ls_banner_upper_tl
              {\ls_error:nn {A~corporate~profile~cannot~render~a~CUI~banner}
                {Use~a~CUI~profile~only~when~the~controlling~authority~requires~CUI.}}
              {}
          }
        {cui-general}
          {
            \ls_require_uppercase_banner:
            \regex_match:nVTF {\A \s* (CUI|CONTROLLED) (\s* /|\s* \Z)}
              \l_ls_banner_upper_tl
              {}
              {\ls_error:nn {The~general~CUI~banner~has~an~invalid~control~prefix}
                {Begin~with~the~authority-approved~CUI~or~CONTROLLED~marking.}}
            \ls_reject_classification_words:
          }
        {cui-dod}
          {
            \ls_require_uppercase_banner:
            \str_if_eq:VnF \l_ls_banner_string_tl {CUI}
              {\ls_error:nn {The~DoD~CUI~profile~requires~the~exact~banner~CUI}
                {Use~CUI~alone~at~the~top~and~bottom;~put~categories~and~controls~in~the~designation~indicator.}}
          }
        {classified-general}
          {\ls_validate_classified_banner:}
        {classified-dod}
          {\ls_validate_classified_banner:}
      }
  }

\cs_new_protected:Npn \ls_validate_classified_banner:
  {
    \ls_require_uppercase_banner:
    \str_if_eq:VnTF \g_ls_classification_tl {top-secret}
      {
        \regex_match:nVTF {\A \s* TOP \s+ SECRET (\s* /|\s* \Z)}
          \l_ls_banner_upper_tl
          {}
          {\ls_error:nn {The~banner~would~remove~or~lower~TOP~SECRET}
            {Keep~the~authority-approved~TOP~SECRET~prefix.}}
        \regex_match:nVTF {CONFIDENTIAL} \l_ls_banner_upper_tl
          {\ls_error:nn {The~TOP~SECRET~banner~contains~a~conflicting~classification~term}
            {Use~the~exact~authority-approved~banner~without~a~lower~classification~level.}}
          {}
      }
      {
        \str_if_eq:VnTF \g_ls_classification_tl {secret}
          {
            \regex_match:nVTF {\A \s* SECRET (\s* /|\s* \Z)}
              \l_ls_banner_upper_tl
              {}
              {\ls_error:nn {The~banner~would~remove~SECRET}
                {Keep~the~authority-approved~SECRET~prefix.}}
            \regex_match:nVTF {TOP \s+ SECRET|CONFIDENTIAL} \l_ls_banner_upper_tl
              {\ls_error:nn {The~SECRET~banner~contains~a~conflicting~classification~term}
                {Use~the~exact~authority-approved~SECRET~banner.}}
              {}
          }
          {
            \bool_set_false:N \l_tmpa_bool
            \str_if_eq:VnT \g_ls_profile_tl {classified-general}
              {\clist_if_in:NnT \g_ls_controls_clist {cui}
                {\bool_set_true:N \l_tmpa_bool}}
            \bool_if:NTF \l_tmpa_bool
              {
                \regex_match:nVTF
                  {\A \s* CONFIDENTIAL \s* // \s* CUI (\s* /|\s* \Z)}
                  \l_ls_banner_upper_tl
                  {}
                  {\ls_error:nn
                    {The~classified-general~CONFIDENTIAL+CUI~banner~has~the~wrong~prefix}
                    {Begin~with~the~exact~authority-approved~prefix~CONFIDENTIAL//CUI.}}
              }
              {
                \regex_match:nVTF {\A \s* CONFIDENTIAL (\s* /|\s* \Z)}
                  \l_ls_banner_upper_tl
                  {}
                  {\ls_error:nn {The~banner~would~remove~CONFIDENTIAL}
                    {Keep~the~authority-approved~CONFIDENTIAL~prefix.}}
              }
            \regex_match:nVTF {TOP \s+ SECRET|SECRET} \l_ls_banner_upper_tl
              {\ls_error:nn
                {The~CONFIDENTIAL~banner~contains~a~conflicting~classification~term}
                {Use~the~exact~authority-approved~CONFIDENTIAL~banner.}}
              {}
          }
      }
    \str_if_eq:VnTF \g_ls_profile_tl {classified-dod}
      {
        \regex_match:nVTF {CUI|CONTROLLED} \l_ls_banner_upper_tl
          {\ls_error:nn {DoD~classified~banners~must~not~contain~CUI}
            {Use~the~classified~banner,~the~prescribed~first-page~warning,~and~CUI~portion~marks.}}
          {}
      }
      {
        \clist_if_in:NnTF \g_ls_controls_clist {cui}
          {
            \regex_match:nVTF {// \s* CUI (\s* /|\s* \Z)} \l_ls_banner_upper_tl
              {}
              {\ls_error:nn {General~classified+CUI~output~requires~CUI~in~the~banner}
                {Use~the~exact~agency-approved~commingled~banner,~for~example~SECRET//CUI.}}
          }
          {
            \regex_match:nVTF {CUI|CONTROLLED} \l_ls_banner_upper_tl
              {\ls_error:nn {The~banner~declares~CUI~but~controls~does~not}
                {Add~cui~only~when~authorized,~or~remove~the~CUI~marking.}}
              {}
          }
      }
  }

\cs_new_protected:Npn \ls_validate_banner_value:n #1
  {
    \ls_canonicalize_banner:n {#1}
    \ls_validate_banner_profile:
    \bool_if:NT \g_ls_config_frozen_bool
      {
        \bool_set_false:N \l_tmpa_bool
        \ls_profile_cui:T {\bool_set_true:N \l_tmpa_bool}
        \str_if_eq:VnT \g_ls_profile_tl {classified-general}
          {\clist_if_in:NnT \g_ls_controls_clist {cui}
            {\bool_set_true:N \l_tmpa_bool}}
        \bool_if:NT \l_tmpa_bool
          {
            \tl_if_eq:NNTF \l_ls_banner_candidate_tl \g_ls_document_banner_tl
              {}
              {\ls_error:nn {A~CUI-bearing~document~must~use~one~inclusive~banner~on~every~page}
                {Runtime~page~or~slide~overrides~must~exactly~match~the~validated~document~banner.}}
          }
      }
    \ls_validate_banner_width:
  }

\cs_new_protected:Npn \ls_freeze_marking_fields:
