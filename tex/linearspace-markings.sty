\cs_new_protected:Npn \ls_shipout_validate:
  {
    \int_gincr:N \g_ls_shipout_page_int
    \bool_if:NF \g_ls_render_page_banners_bool
      {
        \tl_if_blank:VF \g_ls_document_banner_tl
          {
            \bool_if:NF \g_ls_alternate_banner_rendered_bool
              {\ls_error:nn {The~alternate~renderer~did~not~emit~the~mandatory~banner}
                {Use~the~registered~theme~banner~templates~on~every~marked~slide.}}
          }
      }
    \int_compare:nNnT {\g_ls_shipout_page_int} = {1}
      {
        \ls_profile_classified:T
          {
            \bool_if:NF \g_ls_classification_block_rendered_bool
              {\ls_error:nn {The~first~classified~page~or~slide~lacks~the~authority~block}
                {Render~\string\LSClassificationAuthorityBlock~or~the~compact~block~before~the~first~shipout.}}
          }
      }
    \int_compare:nNnT {\g_ls_shipout_page_int} = {\g_ls_notice_deadline_int}
      {
        \ls_notices_required:T
          {
            \bool_if:NF \g_ls_marking_notices_rendered_bool
              {\ls_error:nn {Required~title-page~notices~were~not~rendered~in~time}
                {Render~the~complete~compact~notice~set~before~the~first~page~or~slide~ships.}}
          }
      }
    \int_compare:nNnT {\g_ls_shipout_page_int} = {2}
      {
        \bool_if:NT \g_ls_dod_export_technical_information_bool
          {
            \bool_if:NF \g_ls_dod_release_notice_rendered_bool
              {\ls_error:nn {The~required~DoDD~5230.25~release~notice~was~not~rendered~by~page~or~slide~2}
                {Use~the~stock~document~title~macro,~or~place~\string\LSMarkingDisclosureFrame~immediately~after~a~Beamer~title~slide.}}
          }
      }
  }

