\cs_new_protected:Npn \ls_render_marking_notices:
  {
    \bool_gset_true:N \g_ls_marking_notices_rendered_bool
    \clist_if_in:NnT \g_ls_controls_clist {proprietary}
      {\LSProprietaryNotice}
    \clist_if_in:NnTF \g_ls_controls_clist {ear}
      {\LSExportControlMetadata}
      {
        \clist_if_in:NnT \g_ls_controls_clist {itar}
          {\LSExportControlMetadata}
      }
    \bool_if:NT \g_ls_dod_export_technical_information_bool
      {
        \ls_regulatory_warning:n {\LSDoDExportControlWarning}
        \bool_if:NF \l_ls_compact_notices_bool
          {\LSDoDReleaseNotice}
      }
    \ls_profile_classified:T {\LSClassificationAuthorityBlock}
    \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
      {\clist_if_in:NnT \g_ls_controls_clist {cui}
        {\ls_notice_box:nn {CUI~WARNING~BOX~FOR~CLASSIFIED~MATERIAL}
          {\ls_classified_cui_warning:}}}
    \tl_if_blank:VF \g_ls_custom_notice_tl
      {\ls_notice_box:nn {ADDITIONAL~HANDLING~NOTICE}{\tl_use:N \g_ls_custom_notice_tl}}
    \clist_if_in:NnT \g_ls_controls_clist {cui}
      {\LSCUIDesignationIndicator}
    \LSDistributionNotice
  }

% Dense title pages use two balanced columns so complete notices remain on the
% cover at a readable size. Each applicable notice is still emitted exactly
% once; this is a layout change, not a shortened-content path.
\cs_new_protected:Npn \ls_render_dense_marking_notices:
  {
    \bool_gset_true:N \g_ls_marking_notices_rendered_bool
    \noindent
    \begin{minipage}[b]{0.492\linewidth}
      \vspace{0pt}
      \clist_if_in:NnT \g_ls_controls_clist {proprietary}
        {\LSProprietaryNotice}
      \clist_if_in:NnTF \g_ls_controls_clist {ear}
        {\LSExportControlMetadata}
        {
          \clist_if_in:NnT \g_ls_controls_clist {itar}
            {\LSExportControlMetadata}
        }
      \bool_if:NT \g_ls_dod_export_technical_information_bool
        {\ls_regulatory_warning:n {\LSDoDExportControlWarning}}
      \tl_if_blank:VF \g_ls_custom_notice_tl
        {\ls_notice_box:nn {ADDITIONAL~HANDLING~NOTICE}
          {\tl_use:N \g_ls_custom_notice_tl}}
    \end{minipage}\hfill
    \begin{minipage}[b]{0.492\linewidth}
      \vspace{0pt}
      \ls_profile_classified:T {\LSClassificationAuthorityBlock}
      \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
        {\clist_if_in:NnT \g_ls_controls_clist {cui}
          {\ls_notice_box:nn {CUI~WARNING~BOX~FOR~CLASSIFIED~MATERIAL}
            {\ls_classified_cui_warning:}}}
      \clist_if_in:NnT \g_ls_controls_clist {cui}
        {\LSCUIDesignationIndicator}
      \LSDistributionNotice
    \end{minipage}\par
  }

