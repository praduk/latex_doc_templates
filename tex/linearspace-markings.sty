  {\ls_portion_mark:n {#1}\nobreakspace #2}
\NewDocumentCommand{\LSPortionMark}{m}
  {\ls_error:nn {Raw~portion~marks~are~disabled}
    {Use~\string\LSU,~\string\LSCUI,~\string\LSC,~\string\LSS,~or~\string\LSTS~so~the~mark~can~be~checked~against~the~profile.}}
\NewDocumentCommand{\LSPortion}{m m}
  {\ls_error:nn {Raw~portion~marks~are~disabled}
    {Use~\string\LSU,~\string\LSCUI,~\string\LSC,~\string\LSS,~or~\string\LSTS~so~the~mark~can~be~checked~against~the~profile.}}
\NewDocumentCommand{\LSU}{m}{\ls_portion:nn {U}{#1}}
\NewDocumentCommand{\LSCUI}{O{} m}
  {
    \clist_if_in:NnTF \g_ls_controls_clist {cui}
      {
        \ls_canonicalize_banner:n {#1}
        \tl_if_blank:VTF \l_ls_banner_candidate_tl
          {\ls_portion:nn {CUI}{#2}}
          {
            \bool_set_false:N \l_tmpa_bool
            \str_if_eq:VnT \g_ls_profile_tl {cui-dod}
              {\bool_set_true:N \l_tmpa_bool}
            \str_if_eq:VnT \g_ls_profile_tl {classified-dod}
              {\bool_set_true:N \l_tmpa_bool}
            \bool_if:NT \l_tmpa_bool
              {\ls_error:nn {DoD~CUI~portions~must~use~the~mark~CUI}
                {Use~\string\LSCUI\{text\};~DoD~category~and~control~details~belong~in~the~designation~indicator.}}
            \ls_require_uppercase_banner:
            \regex_match:nVTF
              {\A (SP-)? [A-Z0-9-]+ ( / (SP-)? [A-Z0-9-]+ )* ( // [A-Z0-9-]+ ( / [A-Z0-9-]+ )* )? \Z}
              \l_ls_banner_upper_tl
              {}
              {\ls_error:nn {The~CUI~portion~category/control~token~has~invalid~syntax}
                {Use~the~exact~uppercase~token~from~the~controlling~authority.}}
            \regex_match:nVTF {CUI|CONTROLLED|CONFIDENTIAL|SECRET|TOP|\A (U|C|S|TS) \Z}
              \l_ls_banner_upper_tl
              {\ls_error:nn {The~optional~CUI~portion~token~is~not~a~category/control}
                {Pass~only~the~authorized~category~or~dissemination~token~after~CUI.}}
              {}
            \tl_set:Nx \l_tmpa_tl
              {\tl_upper_case:n {\tl_to_str:V \g_ls_document_banner_tl}}
            \regex_replace_all:nnN {\s+} {} \l_tmpa_tl
            \tl_put_left:Nn \l_tmpa_tl {/}
            \tl_put_right:Nn \l_tmpa_tl {/}
            \tl_set:Nx \l_tmpb_tl
              {/\tl_upper_case:n {\tl_to_str:V \l_ls_banner_candidate_tl}/}
            \tl_if_in:VVTF \l_tmpa_tl \l_tmpb_tl
              {\ls_portion:nn {CUI//\tl_use:N \l_ls_banner_candidate_tl}{#2}}
              {\ls_error:nn {The~CUI~portion~token~is~absent~from~the~document~banner}
                {Every~CUI~portion~category/control~must~be~included~in~the~validated~inclusive~banner.}}
          }
      }
      {\ls_error:nn {A~CUI~portion~mark~requires~controls={cui}}
        {Configure~an~authorized~CUI~or~classified~profile~before~using~\string\LSCUI.}}
  }
